    : "text-[#38231C]";

  const secondaryText = isDarkMode
    ? "text-[#B7B0A5]"
    : "text-[#806B5D]";

  const iconContainer = isDarkMode
    ? "bg-[#292E2B]"
    : "bg-[#FFF0D8]";

