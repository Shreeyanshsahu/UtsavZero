<file path="src/components/hostevents/registrations/RegistrationStats.tsx">
"use client";

import {
  ClipboardList,
  Users,
  CheckCircle2,
  UserCheck,
} from "lucide-react";

import { useTheme } from "@/context/ThemeContext";
import type { OrganizerRegistration } from "@/services/hostevents/registrationService";

interface RegistrationStatsProps {
  registrations: OrganizerRegistration[];
}

export default function RegistrationStats({
  registrations,
}: RegistrationStatsProps) {
  const { isDarkMode } = useTheme();

  // Count confirmed bookings.
  const confirmedBookings = registrations.filter(
    (registration) => registration.status === "confirmed"
  );

  // Sum the number of attendees in confirmed group bookings.
  const totalAttendees = confirmedBookings.reduce(
    (total, registration) => total + registration.quantity,
    0
  );

  // Count attendees belonging to group tickets marked as checked in.
  const checkedInAttendees = confirmedBookings.reduce(
    (total, registration) => {
      if (registration.ticket?.status === "checked_in") {
        return total + registration.quantity;
      }

      return total;
    },
    0
  );

  const stats = [
    {
      label: "Total Registrations",
      value: registrations.length,
      icon: ClipboardList,
      iconColor: "text-blue-500",
      iconBackground: isDarkMode ? "bg-blue-500/10" : "bg-blue-50",
    },
    {
      label: "Confirmed Bookings",
      value: confirmedBookings.length,
      icon: CheckCircle2,
      iconColor: "text-emerald-500",
      iconBackground: isDarkMode
        ? "bg-emerald-500/10"
        : "bg-emerald-50",
    },
    {
      label: "Total Attendees",
      value: totalAttendees,
      icon: Users,
      iconColor: "text-orange-500",
      iconBackground: isDarkMode
        ? "bg-orange-500/10"
        : "bg-orange-50",
    },
    {
      label: "Checked-in Attendees",
      value: checkedInAttendees,
      icon: UserCheck,
      iconColor: "text-purple-500",
      iconBackground: isDarkMode
        ? "bg-purple-500/10"
        : "bg-purple-50",
    },
  ];

  return (
    <div className="mb-6 grid grid-cols-1 gap-4 sm:grid-cols-2 xl:grid-cols-4">
      {stats.map((stat) => {
        const Icon = stat.icon;

        return (
          <div
            key={stat.label}
            className={`rounded-2xl border p-5 transition-colors ${
              isDarkMode
                ? "border-[#34463A] bg-[#202C24]"
                : "border-[#E9E8DF] bg-white"
            }`}
          >
            <div className="flex items-center justify-between gap-3">
              <div>
                <p
                  className={`text-sm font-medium ${
                    isDarkMode
                      ? "text-[#B7B0A5]"
                      : "text-[#806B5D]"
                  }`}
                >
                  {stat.label}
                </p>

                <p
                  className={`mt-3 text-3xl font-bold tabular-nums ${
                    isDarkMode
                      ? "text-[#FFF8EB]"
                      : "text-[#38231C]"
                  }`}
                >
                  {stat.value.toLocaleString("en-IN")}
                </p>
              </div>

              <div
                className={`flex h-12 w-12 shrink-0 items-center justify-center rounded-xl ${stat.iconBackground}`}
              >
                <Icon size={22} className={stat.iconColor} />
              </div>
            </div>
          </div>
        );
      })}
    </div>
  );
}
</file>

<file path="src/components/hostevents/registrations/RegistrationTable.tsx">
"use client";

import {
  Eye,
  Users,
  CalendarDays,
  Ticket,
  Inbox,
} from "lucide-react";

import { useTheme } from "@/context/ThemeContext";

import type {
  OrganizerRegistration,
} from "@/services/hostevents/registrationService";

interface RegistrationTableProps {
  registrations: OrganizerRegistration[];
  onViewDetails: (registration: OrganizerRegistration) => void;
}

function formatDate(date: string) {
  return new Date(date).toLocaleDateString("en-IN", {
    day: "numeric",
    month: "short",
    year: "numeric",
  });
}

function getStatusClasses(status: string, isDarkMode: boolean) {
  const styles: Record<string, string> = {
    confirmed: isDarkMode
      ? "bg-emerald-500/10 text-emerald-400"
      : "bg-emerald-50 text-emerald-700",

    cancelled: isDarkMode
      ? "bg-red-500/10 text-red-400"
      : "bg-red-50 text-red-700",

    expired: isDarkMode
      ? "bg-orange-500/10 text-orange-400"
      : "bg-orange-50 text-orange-700",
  };

  return styles[status] ??
    (isDarkMode
      ? "bg-gray-500/10 text-gray-400"
      : "bg-gray-100 text-gray-600");
}

export default function RegistrationTable({
  registrations,
  onViewDetails,
}: RegistrationTableProps) {
  const { isDarkMode } = useTheme();

  const headingClass = isDarkMode
    ? "text-[#AFAFA5]"
    : "text-[#806B5D]";

  const primaryText = isDarkMode
    ? "text-[#FFF8EB]"
    : "text-[#38231C]";

  const secondaryText = isDarkMode
    ? "text-[#AFAFA5]"
    : "text-[#8A7B70]";

  // Empty state
  if (registrations.length === 0) {
    return (
      <div
        className={`flex flex-col items-center justify-center rounded-2xl border px-6 py-16 text-center ${
          isDarkMode
            ? "border-[#34463A] bg-[#202C24]"
            : "border-[#E9E8DF] bg-white"
        }`}
      >
        <div
          className={`mb-4 flex h-14 w-14 items-center justify-center rounded-2xl ${
            isDarkMode ? "bg-[#34463A]" : "bg-[#F0F3EC]"
          }`}
        >
          <Inbox
            size={26}
            className={isDarkMode ? "text-[#B9DFBF]" : "text-[#52765B]"}
          />
        </div>

        <h3 className={`text-lg font-semibold ${primaryText}`}>
          No registrations found
        </h3>

        <p className={`mt-2 max-w-sm text-sm ${secondaryText}`}>
          There are no registrations matching your current filters.
          New bookings will appear here automatically when loaded.
        </p>
      </div>
    );
  }

  return (
    <div
      className={`overflow-hidden rounded-2xl border ${
        isDarkMode
          ? "border-[#34463A] bg-[#202C24]"
          : "border-[#E9E8DF] bg-white"
      }`}
    >
      {/* Table heading */}
      <div className="flex items-center justify-between gap-3 p-5">
        <div>
          <h3 className={`text-base font-bold ${primaryText}`}>
            All Registrations
          </h3>

          <p className={`mt-1 text-xs ${secondaryText}`}>
            {registrations.length} registration
            {registrations.length !== 1 ? "s" : ""} found
          </p>
        </div>

        <div
          className={`flex items-center gap-2 rounded-lg px-3 py-2 text-xs font-medium ${
            isDarkMode
              ? "bg-[#34463A] text-[#C6D4C8]"
              : "bg-[#F0F3EC] text-[#52765B]"
          }`}
        >
          <Users size={14} />
          Group bookings
        </div>
      </div>

      {/* Responsive table */}
      <div className="overflow-x-auto">
        <table className="w-full min-w-[950px] text-left">
          <thead
            className={
              isDarkMode
                ? "border-y border-[#34463A] bg-[#26352A]"
                : "border-y border-[#E9E8DF] bg-[#F8F8F3]"
            }
          >
            <tr>
              {[
                "Attendee",
                "Event",
                "Booking Reference",
                "Participants",
                "Booking Date",
                "Booking Status",
                "Check-in",
                "Action",
              ].map((heading) => (
                <th
                  key={heading}
                  className={`px-5 py-3 text-xs font-semibold uppercase tracking-wider ${headingClass}`}
                >
                  {heading}
                </th>
              ))}
            </tr>
          </thead>

          <tbody>
            {registrations.map((registration) => {
              const isCheckedIn =
                registration.ticket?.status === "checked_in";

              return (
                <tr
                  key={registration.id}
                  className={`border-b last:border-b-0 transition-colors ${
                    isDarkMode
                      ? "border-[#34463A] hover:bg-[#26352A]"
                      : "border-[#F0EFE8] hover:bg-[#FAFBF8]"
                  }`}
                >
                  {/* Attendee */}
                  <td className="px-5 py-4">
                    <p className={`whitespace-nowrap text-sm font-semibold ${primaryText}`}>
                      {registration.attendee_name}
                    </p>

                    <p className={`mt-1 text-xs ${secondaryText}`}>
                      {registration.attendee_email}
                    </p>
                  </td>

                  {/* Event */}
                  <td className="px-5 py-4">
                    <p className={`max-w-[190px] truncate text-sm font-medium ${primaryText}`}>
                      {registration.event.title}
                    </p>

                    <p className={`mt-1 whitespace-nowrap text-xs ${secondaryText}`}>
                      {formatDate(registration.event.starts_at)}
                    </p>
                  </td>

                  {/* Booking reference */}
                  <td className="px-5 py-4">
                    <span className={`whitespace-nowrap font-mono text-xs ${primaryText}`}>
                      {registration.booking_reference}
                    </span>
                  </td>

                  {/* Participants */}
                  <td className="px-5 py-4">
                    <div className={`flex items-center gap-1.5 text-sm ${primaryText}`}>
                      <Users size={14} />
                      {registration.quantity}
                    </div>
                  </td>

                  {/* Booking date */}
                  <td className="px-5 py-4">
                    <span className={`whitespace-nowrap text-sm ${secondaryText}`}>
                      {formatDate(registration.created_at)}
                    </span>
                  </td>

                  {/* Booking status */}
                  <td className="px-5 py-4">
                    <span
                      className={`whitespace-nowrap rounded-full px-2.5 py-1 text-xs font-semibold capitalize ${getStatusClasses(
                        registration.status,
                        isDarkMode
                      )}`}
                    >
                      {registration.status}
                    </span>
                  </td>

                  {/* Check-in */}
                  <td className="px-5 py-4">
                    <span
                      className={`whitespace-nowrap text-xs font-semibold ${
                        isCheckedIn
                          ? "text-emerald-500"
                          : secondaryText
                      }`}
                    >
                      {isCheckedIn ? "Checked in" : "Not checked in"}
                    </span>
                  </td>

                  {/* View details */}
                  <td className="px-5 py-4">
                    <button
                      type="button"
                      onClick={() => onViewDetails(registration)}
                      className={`inline-flex items-center gap-1.5 whitespace-nowrap rounded-lg px-3 py-2 text-xs font-semibold transition-colors ${
                        isDarkMode
                          ? "bg-[#34463A] text-[#C6D4C8] hover:bg-[#405644]"
                          : "bg-[#F0F3EC] text-[#52765B] hover:bg-[#E4EBE1]"
                      }`}
                    >
                      <Eye size={14} />
                      View
                    </button>
                  </td>
                </tr>
              );
            })}
          </tbody>
        </table>
      </div>
    </div>
  );
}
</file>

<file path="src/components/layout/navbar/MobileNavigation.tsx">
"use client";

import { useState } from "react";
import Link from "next/link";
import { Menu, X, UserRound, LogOut } from "lucide-react";
import { useAuth } from "@/context/AuthContext";

interface NavLink {
  name: string;
  href: string;
}

interface MobileNavigationProps {
  links: NavLink[];
  isDarkMode: boolean;
}

export default function MobileNavigation({
  links,
  isDarkMode,
}: MobileNavigationProps) {
  const [isOpen, setIsOpen] = useState(false);
  const { user, profile, loading, signOut } = useAuth();
  const [signingOut, setSigningOut] = useState(false);

  const closeMenu = () => setIsOpen(false);

  const handleLogout = async () => {
    if (signingOut) return;

    setSigningOut(true);

    const { error } = await signOut();

    if (error) {
      console.error("Logout failed:", error.message);
      setSigningOut(false);
      return;
    }

    closeMenu();
    window.location.href = "/";
  };

  const displayName =
    profile?.full_name || user?.email?.split("@")[0] || "My Account";

  return (
    <div className="relative md:hidden">
      <button
        type="button"
        onClick={() => setIsOpen((previous) => !previous)}
        aria-label={isOpen ? "Close menu" : "Open menu"}
        aria-expanded={isOpen}
        aria-controls="mobile-navigation"
        className={`flex h-11 w-11 items-center justify-center rounded-full transition-colors ${
          isDarkMode
            ? "bg-[#292E2B] text-[#FFF8EB]"
            : "bg-[#FFF0D8] text-[#38231C]"
        }`}
      >
        {isOpen ? <X size={21} /> : <Menu size={21} />}
      </button>

      {isOpen && (
        <div
          id="mobile-navigation"
          className={`absolute right-0 top-full z-50 mt-3 w-[min(92vw,360px)] rounded-2xl border px-4 pb-5 pt-3 shadow-xl ${
            isDarkMode
              ? "border-[#343B36] bg-[#171A19]"
              : "border-[#EADCC9] bg-[#FFF8EB]"
          }`}
        >
          <nav className="flex flex-col gap-1">
            {links.map((link) => (
              <Link
                key={link.href}
                href={link.href}
                onClick={closeMenu}
                className={`rounded-xl px-4 py-3 text-sm font-medium transition-colors ${
                  isDarkMode
                    ? "text-[#FFF8EB] hover:bg-[#292E2B]"
                    : "text-[#38231C] hover:bg-[#FFF0D8]"
                }`}
              >
                {link.name}
              </Link>
            ))}
          </nav>

          <div
            className={`mt-3 border-t pt-4 ${
              isDarkMode ? "border-[#343B36]" : "border-[#EADCC9]"
            }`}
          >
            {loading ? (
              <p className="px-4 py-2 text-sm text-gray-500">
                Loading account...
              </p>
            ) : user ? (
              <div className="flex items-center justify-between gap-3 px-2">
                <div className="flex min-w-0 items-center gap-3">
                  <div
                    className={`flex h-10 w-10 shrink-0 items-center justify-center rounded-full ${
                      isDarkMode
                        ? "bg-[#292E2B] text-[#FFBE45]"
                        : "bg-[#FFF0D8] text-[#F0440A]"
                    }`}
                  >
                    <UserRound size={19} />
                  </div>

                  <div className="min-w-0">
                    <p
                      className={`truncate text-sm font-semibold ${
                        isDarkMode
                          ? "text-[#FFF8EB]"
                          : "text-[#38231C]"
                      }`}
                    >
                      {displayName}
                    </p>
                    <p className="text-xs text-gray-500">Signed in</p>
                  </div>
                </div>

                <button
                  type="button"
                  onClick={handleLogout}
                  disabled={signingOut}
                  aria-label="Sign out"
                  className="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-[#F0440A] text-white disabled:opacity-50"
                >
                  <LogOut size={18} />
                </button>
              </div>
            ) : (
              <div className="flex gap-3 px-2">
                <Link
                  href="/login"
                  onClick={closeMenu}
                  className={`flex-1 rounded-xl border px-4 py-3 text-center text-sm font-medium ${
                    isDarkMode
                      ? "border-[#454B46] text-[#FFF8EB]"
                      : "border-[#EADCC9] text-[#38231C]"
                  }`}
                >
                  Login
                </Link>

                <Link
                  href="/signup"
                  onClick={closeMenu}
                  className="flex-1 rounded-xl bg-gradient-to-r from-[#FFBE45] to-[#F0440A] px-4 py-3 text-center text-sm font-semibold text-white"
                >
                  Sign Up
                </Link>
              </div>
            )}
          </div>
        </div>
      )}
    </div>
  );
}
</file>

<file path="src/components/layout/navbar/RoleNavigation.tsx">
"use client";

import { usePathname } from "next/navigation";
import {
  LayoutDashboard,
  CalendarPlus,
  ShieldCheck,
  UserRound,
} from "lucide-react";

import { useAuth } from "@/context/AuthContext";
import ExpandableNavItem from "./ExpandableNavItem";

interface RoleNavigationProps {
  isDarkMode: boolean;
}

export default function RoleNavigation({
  isDarkMode,
}: RoleNavigationProps) {
  const pathname = usePathname();
  const { user, roles, loading } = useAuth();

  if (loading || !user) return null;

  const isCivicAdmin = roles.includes("civic_demo_admin");
  const isOrganizer = roles.includes("private_organizer");
  const isCitizen = roles.includes("citizen");

  // Higher-level roles take priority over the default citizen role.
  const navigationItems = isCivicAdmin
    ? [
        {
          label: "Civic Portal",
          href: "/civic",
          icon: ShieldCheck,
        },
      ]
    : isOrganizer
    ? [
        {
          label: "Dashboard",
          href: "/organizer",
          icon: LayoutDashboard,
        },
        {
          label: "Host Event",
          href: "/organizer/organize",
          icon: CalendarPlus,
        },
      ]
    : isCitizen
    ? [
        {
          label: "Profile",
          href: "/profile",
          icon: UserRound,
        },
      ]
    : [];

  return (
    <div className="flex items-center gap-2">
      {navigationItems.map((item) => (
        <ExpandableNavItem
          key={item.href}
          href={item.href}
          label={item.label}
          icon={item.icon}
          isActive={
            pathname === item.href ||
            pathname.startsWith(`${item.href}/`)
          }
          isDarkMode={isDarkMode}
        />
      ))}
    </div>
  );
}
</file>

