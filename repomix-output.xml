                  )}
                  Continue with Google
                </button>

                <div className="my-6 flex items-center gap-4">
                  <div className="h-px flex-1 bg-[#EADCC9]" />
                  <span className="text-xs text-[#806B5D]">
                    OR SIGN UP WITH EMAIL
                  </span>
                  <div className="h-px flex-1 bg-[#EADCC9]" />
                </div>
              </>
            )}

            <form onSubmit={handleSignup} className="space-y-4">
