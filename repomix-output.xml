      if (fetchError) throw fetchError;

      setEvents((data ?? []) as OrganizerEvent[]);
    } catch (err) {
      setError(
        err instanceof Error ? err.message : "Unable to load your events."
      );
    } finally {
      setLoading(false);
    }
  }, []);
useEffect(() => {
