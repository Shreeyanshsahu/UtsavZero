interface FeatureCardProps {
  title: string;
  location: string;
  image: string;
  category: string;
  seatsAvailable: number;
  totalSeats: number;
  onClick?: () => void;
}

export default function FeatureCard({
  title,
  location,
  image,
  category,
  seatsAvailable,
  totalSeats,
  onClick,
}: FeatureCardProps) {
  const { isDarkMode } = useTheme();

  const availableSeats = Math.max(0, seatsAvailable);
  const isFullyBooked = availableSeats === 0;

  return (
    <article
      onClick={onClick}
