          <section className={`overflow-hidden rounded-2xl border p-3 sm:p-5 ${panel}`}>
            <div className="mb-4 flex items-center justify-between gap-3">
              <div>
                <h2 className="font-semibold">QR Scanner</h2>
                <p className={`mt-1 text-xs sm:text-sm ${muted}`}>
                  Position the attendee&apos;s QR code inside the frame.
                </p>
              </div>

              <span className="flex shrink-0 items-center gap-1.5 rounded-full bg-green-100 px-2.5 py-1.5 text-xs font-semibold text-green-800 dark:bg-green-950 dark:text-green-300">
                <span className="h-2 w-2 rounded-full bg-green-500" />
                Ready
              </span>
            </div>

            <CameraScanner
              key={scannerKey}
              onScan={handleScan}
              disabled={loading}
            />

            {loading && (
              <div className="mt-4 flex items-center justify-center gap-2 rounded-xl bg-[#FFF0D8] p-4 text-sm font-semibold text-[#A83A12] dark:bg-[#3A2B20] dark:text-[#FFBE45]">
                <Loader2 size={18} className="animate-spin" />
                Verifying ticket with UtsavZero...
              </div>
            )}

            {error && (
              <div className="mt-4 flex items-start gap-2 rounded-xl border border-red-200 bg-red-50 p-3 text-sm text-red-700 dark:border-red-900 dark:bg-red-950/40 dark:text-red-300">
                <AlertCircle size={18} className="mt-0.5 shrink-0" />
                <span>{error}</span>
              </div>
            )}
          </section>
        )}

        {/* Verification result */}
        {currentResult && ResultIcon && (
          <section className={`rounded-2xl border p-5 sm:p-7 ${panel}`}>
            <div className="text-center">
              <div className={`mx-auto flex h-20 w-20 items-center justify-center rounded-full ${
                result === "success"
                  ? "bg-green-100 text-green-600 dark:bg-green-950 dark:text-green-300"
                  : result === "already_used" || result === "expired"
                    ? "bg-amber-100 text-amber-700 dark:bg-amber-950 dark:text-amber-300"
                    : "bg-red-100 text-red-600 dark:bg-red-950 dark:text-red-300"
              }`}>
                <ResultIcon size={38} />
              </div>

              <h2 className="mt-5 text-xl font-bold sm:text-2xl">
                {currentResult.title}
              </h2>

              <p className={`mx-auto mt-2 max-w-md text-sm leading-relaxed ${muted}`}>
                {currentResult.message}
              </p>
            </div>

            <div className={`mt-6 rounded-xl border p-4 ${dark ? currentResult.dark : currentResult.light}`}>
              <div className="flex items-center gap-2">
                <ResultIcon size={19} />
                <span className="text-sm font-semibold">
                  {result === "success"
                    ? "Entry permitted"
                    : "Entry not permitted"}
                </span>
              </div>
            </div>

            <button
              type="button"
              onClick={handleNextScan}
              className="mt-6 flex min-h-12 w-full items-center justify-center gap-2 rounded-xl bg-[#F0440A] px-5 py-3.5 text-sm font-bold text-white transition hover:bg-[#D93808] active:scale-[0.99]"
            >
              <RefreshCw size={18} />
              Scan Next Ticket
            </button>
          </section>
        )}

        {/* Instructions */}
        {!result && (
          <section className={`rounded-2xl border p-4 sm:p-5 ${panel}`}>
            <h3 className="text-sm font-semibold">
              How check-in works
            </h3>

            <ol className={`mt-3 space-y-3 text-sm ${muted}`}>
              <li className="flex gap-3">
                <span className="flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-[#FFF0D8] text-xs font-bold text-[#F0440A] dark:bg-[#3A2B20]">
                  1
                </span>
                Ask the attendee to open their UtsavZero digital ticket.
              </li>

              <li className="flex gap-3">
                <span className="flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-[#FFF0D8] text-xs font-bold text-[#F0440A] dark:bg-[#3A2B20]">
                  2
                </span>
                Scan the QR code using the camera above.
              </li>

              <li className="flex gap-3">
                <span className="flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-[#FFF0D8] text-xs font-bold text-[#F0440A] dark:bg-[#3A2B20]">
                  3
                </span>
                Allow entry only when the result says Ticket Verified.
              </li>
            </ol>
          </section>
        )}

        <p className={`px-2 text-center text-xs ${muted}`}>
          UtsavZero securely validates tickets through its booking database.
        </p>
      </div>
    </OrganizerLayout>
  );
}
</file>

<file path="src/app/organizer/registrations/page.tsx">
"use client";

import { useMemo, useState } from "react";
import { AlertCircle, RefreshCw } from "lucide-react";

import OrganizerLayout from "@/components/hostevents/layout/OrganizerLayout";
import RegistrationStats from "@/components/hostevents/registrations/RegistrationStats";
import RegistrationFilters from "@/components/hostevents/registrations/RegistrationFilters";
import RegistrationTable from "@/components/hostevents/registrations/RegistrationTable";
import BookingDetails from "@/components/hostevents/registrations/BookingDetails";

import { useRegistrations } from "@/hooks/hostevents/useRegistrations";
import { useTheme } from "@/context/ThemeContext";

import type {
  OrganizerRegistration,
  RegistrationEvent,
} from "@/services/hostevents/registrationService";

export default function RegistrationsPage() {
  const { isDarkMode } = useTheme();

  // Fetch registration data.
  const {
    registrations,
    loading,
    error,
    refresh,
  } = useRegistrations();

  // Search and filter state.
  const [searchQuery, setSearchQuery] = useState("");
  const [selectedEvent, setSelectedEvent] = useState("all");
  const [selectedStatus, setSelectedStatus] = useState("all");

  // Currently selected registration for the details modal.
  const [selectedRegistration, setSelectedRegistration] =
    useState<OrganizerRegistration | null>(null);

  // Extract unique events from the loaded registrations.
  const events = useMemo<RegistrationEvent[]>(() => {
    const eventMap = new Map<string, RegistrationEvent>();

    registrations.forEach((registration) => {
      eventMap.set(registration.event.id, registration.event);
    });

    return Array.from(eventMap.values());
  }, [registrations]);

  // Apply search and filters.
  const filteredRegistrations = useMemo(() => {
    const query = searchQuery.trim().toLowerCase();

    return registrations.filter((registration) => {
      // Search by attendee, email, booking reference or ticket.
      const matchesSearch =
        query === "" ||
        registration.attendee_name.toLowerCase().includes(query) ||
        registration.attendee_email.toLowerCase().includes(query) ||
        registration.booking_reference.toLowerCase().includes(query) ||
        registration.event.title.toLowerCase().includes(query) ||
        (registration.ticket?.ticket_number ?? "")
          .toLowerCase()
          .includes(query);

      // Filter by event.
      const matchesEvent =
        selectedEvent === "all" ||
        registration.event_id === selectedEvent;

      // Filter by booking status.
      const matchesStatus =
        selectedStatus === "all" ||
        registration.status === selectedStatus;

      return matchesSearch && matchesEvent && matchesStatus;
    });
  }, [
    registrations,
    searchQuery,
    selectedEvent,
    selectedStatus,
  ]);

  const handleViewDetails = (
    registration: OrganizerRegistration
  ) => {
    setSelectedRegistration(registration);
  };

  return (
    <OrganizerLayout
      title="Registrations"
      description="Manage attendee registrations and group bookings for your events."
    >
      <div className="space-y-5">

        {/* Refresh action */}
        <div className="flex justify-end">
          <button
            type="button"
            onClick={() => void refresh()}
            disabled={loading}
            className={`inline-flex items-center gap-2 rounded-xl border px-4 py-2.5 text-sm font-semibold transition-colors disabled:cursor-not-allowed disabled:opacity-60 ${
              isDarkMode
                ? "border-[#34463A] bg-[#22372A] text-[#C0D0C3] hover:bg-[#294333]"
                : "border-[#E4EAE1] bg-white text-[#52675A] hover:bg-[#F3F6F1]"
            }`}
          >
            <RefreshCw
              size={16}
              className={loading ? "animate-spin" : ""}
            />
            {loading ? "Loading..." : "Refresh"}
          </button>
        </div>

        {/* Error state */}
        {error && (
          <div
            className={`flex flex-col gap-3 rounded-xl border p-4 sm:flex-row sm:items-center sm:justify-between ${
              isDarkMode
                ? "border-red-500/30 bg-red-500/10"
                : "border-red-200 bg-red-50"
            }`}
          >
            <div className="flex items-start gap-3">
              <AlertCircle
                size={20}
                className="mt-0.5 shrink-0 text-red-500"
              />

              <div>
                <p className="text-sm font-semibold text-red-500">
                  Unable to load registrations
                </p>

                <p className="mt-1 text-sm text-red-500/80">
                  {error}
                </p>
              </div>
            </div>

            <button
              type="button"
              onClick={() => void refresh()}
              disabled={loading}
              className="self-start rounded-lg bg-red-500 px-4 py-2 text-xs font-semibold text-white transition-colors hover:bg-red-600 disabled:opacity-50 sm:self-center"
            >
              Try again
            </button>
          </div>
        )}

        {/* Loading state */}
        {loading && registrations.length === 0 ? (
          <div
            className={`rounded-2xl border p-12 text-center ${
              isDarkMode
                ? "border-[#34463A] bg-[#202C24]"
                : "border-[#E9E8DF] bg-white"
            }`}
          >
            <RefreshCw
              size={28}
              className="mx-auto animate-spin text-[#72977A]"
            />

            <p
              className={`mt-4 text-sm font-medium ${
                isDarkMode
                  ? "text-[#FFF8EB]"
                  : "text-[#38231C]"
              }`}
            >
              Loading your registrations...
            </p>
          </div>
        ) : (
          <>
            {/* Statistics */}
            <RegistrationStats
              registrations={registrations}
            />

            {/* Filters */}
            <RegistrationFilters
              events={events}
              searchQuery={searchQuery}
              onSearchChange={setSearchQuery}
              selectedEvent={selectedEvent}
              onEventChange={setSelectedEvent}
              selectedStatus={selectedStatus}
              onStatusChange={setSelectedStatus}
            />

            {/* Registrations table */}
            <RegistrationTable
              registrations={filteredRegistrations}
              onViewDetails={handleViewDetails}
            />
          </>
        )}

        {/* Booking details modal */}
        <BookingDetails
          registration={selectedRegistration}
          onClose={() => setSelectedRegistration(null)}
        />

      </div>
    </OrganizerLayout>
  );
}
</file>

<file path="src/app/signup/page.tsx">
"use client";

import { Suspense, useState, type FormEvent } from "react";
import Link from "next/link";
import { useRouter, useSearchParams } from "next/navigation";
import {
  ArrowLeft,
  ArrowRight,
  UserRound,
  Building2,
  ShieldCheck,
  Mail,
  Lock,
  Loader2,
} from "lucide-react";
import { useAuth, type SignupRole } from "@/context/AuthContext";

const accountTypes: {
  role: SignupRole;
  title: string;
  description: string;
  icon: typeof UserRound;
  note: string;
}[] = [
  {
    role: "citizen",
    title: "Citizen",
    description: "Discover events, book tickets and participate in cleaner celebrations.",
    icon: UserRound,
    note: "Create your personal UtsavZero account.",
  },
  {
    role: "government_personnel",
    title: "Government Personnel",
    description: "Apply for verified government organizer access.",
    icon: ShieldCheck,
    note: "Government access requires review and approval by the designated reviewer.",
  },
  {
    role: "private_organizer",
    title: "Private Organizer",
    description: "Host and manage private, firecracker-free community events.",
    icon: Building2,
    note: "You can manage events after registration.",
  },
];

function SignupContent() {
  const router = useRouter();
  const searchParams = useSearchParams();
  const { signUp, signInWithGoogle } = useAuth();

  const roleParam = searchParams.get("role");

  const selectedRole = accountTypes.find(
    (item) => item.role === roleParam
  )?.role;

  const [fullName, setFullName] = useState("");
  const [email, setEmail] = useState("");
  const [password, setPassword] = useState("");
  const [confirmPassword, setConfirmPassword] = useState("");

  const [loading, setLoading] = useState(false);
  const [googleLoading, setGoogleLoading] = useState(false);
  const [error, setError] = useState("");

  const handleSignup = async (event: FormEvent<HTMLFormElement>) => {
    event.preventDefault();
    setError("");

    if (!selectedRole) return;

    if (password.length < 8) {
      setError("Password must contain at least 8 characters.");
      return;
    }

    if (password !== confirmPassword) {
      setError("Passwords do not match.");
      return;
    }

    setLoading(true);

    try {
      const result = await signUp(
        email.trim(),
        password,
        fullName.trim(),
        selectedRole
      );

      if (result.error) {
        setError(result.error.message);
        return;
      }

      const destination =
        selectedRole === "government_personnel"
          ? "/government-authorization/apply"
          : selectedRole === "private_organizer"
          ? "/organizer"
          : "/profile";

      if (result.session && result.user) {
        router.replace(destination);
        router.refresh();
        return;
      }

      if (result.user && !result.session) {
        router.replace(
          `/verify-email?email=${encodeURIComponent(email.trim())}`
        );
        return;
      }

      setError("Signup could not be completed. Please try again.");
    } catch (err) {
      console.error("Signup error:", err);
      setError("Something went wrong. Please try again.");
    } finally {
      setLoading(false);
    }
  };

  const handleGoogleSignup = async () => {
    setError("");
    setGoogleLoading(true);

    try {
      const { error } = await signInWithGoogle("/profile");

      if (error) {
        setError(error.message);
        setGoogleLoading(false);
      }
    } catch (err) {
      console.error("Google signup error:", err);
      setError("Unable to start Google sign-in. Please try again.");
      setGoogleLoading(false);
    }
  };

  return (
    <main className="flex min-h-[calc(100vh-68px)] items-center justify-center bg-[#FFF8EB] px-4 py-12">
      <div className="w-full max-w-xl rounded-3xl border border-[#EADCC9] bg-white p-6 shadow-xl sm:p-9">

        {!selectedRole ? (
          <>
            <div className="mb-8 text-center">
              <p className="mb-3 text-xs font-bold uppercase tracking-[0.2em] text-[#F0440A]">
                Welcome to UtsavZero
              </p>

              <h1 className="text-3xl font-bold text-[#38231C]">
                Join the celebration
              </h1>

              <p className="mt-3 text-sm leading-6 text-[#806B5D]">
                Choose how you want to participate in cleaner celebrations.
              </p>
            </div>

            <div className="space-y-3">
              {accountTypes.map((account) => {
                const Icon = account.icon;

                return (
                  <Link
                    key={account.role}
                    href={`/signup?role=${account.role}`}
                    className="group flex items-center gap-4 rounded-2xl border border-[#EADCC9] p-4 transition hover:border-[#F0440A] hover:bg-[#FFF8EB] sm:p-5"
                  >
                    <div className="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl bg-[#FFF0D8] text-[#F0440A]">
                      <Icon size={23} />
                    </div>

                    <div className="min-w-0 flex-1">
                      <h2 className="font-semibold text-[#38231C]">
                        {account.title}
                      </h2>
                      <p className="mt-1 text-xs leading-5 text-[#806B5D]">
                        {account.description}
                      </p>
                    </div>

                    <ArrowRight
                      size={20}
                      className="shrink-0 text-[#A58B78] transition group-hover:translate-x-1 group-hover:text-[#F0440A]"
                    />
                  </Link>
                );
              })}
            </div>
          </>
        ) : (
          <>
            <Link
              href="/signup"
              className="mb-6 inline-flex items-center gap-2 text-sm font-medium text-[#806B5D] hover:text-[#F0440A]"
            >
              <ArrowLeft size={16} />
              Change account type
            </Link>

            <div className="mb-7">
              <p className="text-xs font-bold uppercase tracking-[0.18em] text-[#F0440A]">
                Create your account
              </p>

              <h1 className="mt-2 text-3xl font-bold text-[#38231C]">
                {accountTypes.find((item) => item.role === selectedRole)?.title}
              </h1>

              <p className="mt-2 text-sm leading-6 text-[#806B5D]">
                {accountTypes.find((item) => item.role === selectedRole)?.note}
              </p>
            </div>

            {selectedRole === "citizen" && (
              <>
                <button
                  type="button"
                  onClick={handleGoogleSignup}
                  disabled={googleLoading || loading}
                  className="flex w-full items-center justify-center gap-3 rounded-xl border border-[#EADCC9] px-4 py-3 font-medium text-[#38231C] transition hover:bg-[#FFF8EB] disabled:opacity-60"
                >
                  {googleLoading ? (
                    <Loader2 className="animate-spin" size={20} />
                  ) : (
                    <svg viewBox="0 0 48 48" className="h-5 w-5">
                      <path fill="#EA4335" d="M24 9.5c3.5 0 6.6 1.2 9 3.5l6.7-6.7C35.6 2.4 30.3 0 24 0 14.6 0 6.5 5.4 2.6 13.2l7.8 6.1C12.3 13.6 17.7 9.5 24 9.5Z" />
                      <path fill="#4285F4" d="M46.1 24.5c0-1.6-.2-3.2-.5-4.7H24v9h12.4c-.6 3-2.3 5.5-4.8 7.2l7.5 5.8c4.4-4.1 7-10.1 7-17.3Z" />
                      <path fill="#FBBC05" d="M10.4 28.7c-.5-1.4-.8-3-.8-4.7s.3-3.2.8-4.7l-7.8-6.1C.9 16.6 0 20.2 0 24s.9 7.4 2.6 10.8l7.8-6.1Z" />
                      <path fill="#34A853" d="M24 48c6.3 0 11.6-2.1 15.4-5.8l-7.5-5.8c-2.1 1.4-4.8 2.2-7.9 2.2-6.3 0-11.7-4.1-13.6-9.8l-7.8 6.1C6.5 42.6 14.6 48 24 48Z" />
                    </svg>
                  )}
                  Continue with Google
                </button>

                <div className="my-6 flex items-center gap-4">
                  <div className="h-px flex-1 bg-[#EADCC9]" />
                  <span className="text-xs text-[#806B5D]">
                    OR SIGN UP WITH EMAIL
                  </span>
                  <div className="h-px flex-1 bg-[#EADCC9]" />
                </div>
              </>
            )}

            <form onSubmit={handleSignup} className="space-y-4">
              <div>
                <label htmlFor="fullName" className="mb-2 block text-sm font-medium text-[#38231C]">
                  Full name
                </label>
                <div className="flex items-center gap-3 rounded-xl border border-[#EADCC9] px-4">
                  <UserRound size={18} className="text-[#806B5D]" />
                  <input
                    id="fullName"
                    required
                    autoComplete="name"
                    value={fullName}
                    onChange={(event) => setFullName(event.target.value)}
                    placeholder="Your full name"
                    className="w-full bg-transparent py-3 text-sm text-[#38231C] outline-none"
                  />
                </div>
              </div>

              <div>
                <label htmlFor="email" className="mb-2 block text-sm font-medium text-[#38231C]">
                  Email address
                </label>
                <div className="flex items-center gap-3 rounded-xl border border-[#EADCC9] px-4">
                  <Mail size={18} className="text-[#806B5D]" />
                  <input
                    id="email"
                    type="email"
                    required
                    autoComplete="email"
                    value={email}
                    onChange={(event) => setEmail(event.target.value)}
                    placeholder="you@example.com"
                    className="w-full bg-transparent py-3 text-sm text-[#38231C] outline-none"
                  />
                </div>
              </div>

              <div>
                <label htmlFor="password" className="mb-2 block text-sm font-medium text-[#38231C]">
                  Password
                </label>
                <div className="flex items-center gap-3 rounded-xl border border-[#EADCC9] px-4">
                  <Lock size={18} className="text-[#806B5D]" />
                  <input
                    id="password"
                    type="password"
                    required
                    minLength={8}
                    autoComplete="new-password"
                    value={password}
                    onChange={(event) => setPassword(event.target.value)}
                    placeholder="At least 8 characters"
                    className="w-full bg-transparent py-3 text-sm text-[#38231C] outline-none"
                  />
                </div>
              </div>

              <div>
                <label htmlFor="confirmPassword" className="mb-2 block text-sm font-medium text-[#38231C]">
                  Confirm password
                </label>
                <div className="flex items-center gap-3 rounded-xl border border-[#EADCC9] px-4">
                  <Lock size={18} className="text-[#806B5D]" />
                  <input
                    id="confirmPassword"
                    type="password"
                    required
                    minLength={8}
                    autoComplete="new-password"
                    value={confirmPassword}
                    onChange={(event) => setConfirmPassword(event.target.value)}
                    placeholder="Re-enter your password"
                    className="w-full bg-transparent py-3 text-sm text-[#38231C] outline-none"
                  />
                </div>
              </div>

              {error && (
                <p role="alert" className="rounded-lg bg-red-50 p-3 text-sm text-red-600">
                  {error}
                </p>
              )}

              <button
                type="submit"
                disabled={loading || googleLoading}
                className="flex w-full items-center justify-center gap-2 rounded-xl bg-gradient-to-r from-[#FFBE45] via-[#FF6A16] to-[#F0440A] py-3 font-semibold text-white shadow-md transition hover:opacity-90 disabled:opacity-60"
              >
                {loading && <Loader2 size={19} className="animate-spin" />}
                {loading ? "Creating account..." : "Create Account"}
              </button>
            </form>
          </>
        )}

        <p className="mt-7 text-center text-sm text-[#806B5D]">
          Already have an account?{" "}
          <Link href="/login" className="font-semibold text-[#F0440A] hover:underline">
            Sign In
          </Link>
        </p>
      </div>
    </main>
  );
}

export default function SignupPage() {
  return (
    <Suspense fallback={<main className="min-h-screen bg-[#FFF8EB]" />}>
      <SignupContent />
    </Suspense>
  );
}
