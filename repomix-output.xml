        >
          {title}
        </h3>

        {/* Location */}
        <p
          className={`mt-1 flex min-w-0 items-center gap-1.5 font-lora text-xs leading-4 ${
            isDarkMode ? "text-[#B8B7A9]" : "text-[#8B7769]"
