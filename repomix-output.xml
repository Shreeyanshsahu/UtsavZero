"use client";

import { useEffect, useState } from "react";
import Link from "next/link";
import { useParams } from "next/navigation";
import { ArrowLeft, ArrowRight, Loader2 } from "lucide-react";

import Navbar from "@/components/layout/Navbar";
import { useTheme } from "@/context/ThemeContext";
import { fetchPublicEvent } from "@/services/events/publicEventService";
import type { Event } from "@/types/event";

import EventHero from "@/components/Events/Details/EventHero";
import EventInformation from "@/components/Events/Details/EventInformation";
import SeatAvailability from "@/components/Events/Details/SeatAvailability";
import EventDescription from "@/components/Events/Details/EventDescription";
import EventGuidelines from "@/components/Events/Details/EventGuidelines";

export default function EventDetailsPage() {
  const params = useParams<{ eventId: string }>();
  const eventId = params.eventId;

  const { isDarkMode, setIsDarkMode } = useTheme();

  const [event, setEvent] = useState<Event | null>(null);
  const [loading, setLoading] = useState(true);
  const [error, setError] = useState("");

  useEffect(() => {
    let active = true;

    async function loadEvent() {
      try {
        setLoading(true);
        setError("");

        const result = await fetchPublicEvent(eventId);

        if (active) {
          setEvent(result);
        }
      } catch (err) {
        if (active) {
          setError(
            err instanceof Error
              ? err.message
              : "Unable to load this celebration."
          );
        }
      } finally {
        if (active) {
          setLoading(false);
        }
      }
    }

    if (eventId) loadEvent();

    return () => {
      active = false;
    };
  }, [eventId]);

  const pageStyle = isDarkMode
    ? "bg-[#171A19] text-[#FFF0D7]"
    : "bg-[#FFF8EB] text-[#3D2923]";

  const backLink = (
    <Link
      href="/events"
      className="inline-flex items-center gap-2 text-sm font-semibold text-[#F0440A] hover:underline"
    >
      <ArrowLeft size={16} />
      Back to celebrations
    </Link>
  );

  return (
    <div className={`min-h-screen ${pageStyle}`}>
      <Navbar
        isDarkMode={isDarkMode}
        setIsDarkMode={setIsDarkMode}
      />

      <main className="mx-auto max-w-6xl px-4 py-8 sm:px-6 lg:px-8">
        {loading ? (
          <div className="flex min-h-[60vh] flex-col items-center justify-center gap-3">
            <Loader2 className="animate-spin text-[#F0440A]" size={32} />
            <p className="text-sm opacity-70">
              Loading celebration details...
            </p>
          </div>
        ) : error ? (
          <div className="flex min-h-[60vh] flex-col items-center justify-center text-center">
            <h1 className="font-lora text-2xl font-bold">
              Unable to load event
            </h1>
            <p className="mt-3 max-w-lg text-sm opacity-70">
              {error}
            </p>
            <div className="mt-6">{backLink}</div>
          </div>
        ) : !event ? (
          <div className="flex min-h-[60vh] flex-col items-center justify-center text-center">
            <h1 className="font-lora text-3xl font-bold">
              Event not found
            </h1>
            <p className="mt-3 text-sm opacity-70">
              This celebration may have ended or is no longer available.
            </p>
            <div className="mt-6">{backLink}</div>
          </div>
        ) : (
          <>
            <div className="mb-5">{backLink}</div>

            <EventHero event={event} />

            <EventInformation event={event} />

            <SeatAvailability event={event} />

            <EventDescription event={event} />

            <EventGuidelines event={event} />

            <div className="mt-8 flex flex-col gap-3 border-t border-[#EADCC9] pt-6 sm:flex-row sm:items-center sm:justify-between">
              <div>
                <p className="font-semibold">
                  Ready to celebrate responsibly?
                </p>
                <p className="mt-1 text-sm opacity-70">
                  Reserve your group entry for this firecracker-free event.
                </p>
              </div>

              {event.totalSeats - event.bookedSeats <= 0 ? (
                <button
                  type="button"
                  disabled
                  className="inline-flex cursor-not-allowed items-center justify-center gap-2 rounded-full bg-gray-400 px-6 py-3.5 text-sm font-bold text-white opacity-70"
                >
                  Fully Booked
                </button>
              ) : (
                <Link
                  href={`/events/${event.id}/book`}
                  className="inline-flex items-center justify-center gap-2 rounded-full bg-[#F0440A] px-6 py-3.5 text-sm font-bold text-white transition hover:bg-[#D93808]"
                >
                  Book Your Tickets
                  <ArrowRight size={17} />
                </Link>
              )}
            </div>
          </>
        )}
      </main>
    </div>
  );
}
</file>

<file path="src/app/login/page.tsx">
"use client";

import { Suspense, useState, type FormEvent } from "react";
import { useSearchParams, useRouter } from "next/navigation";
import Link from "next/link";
import { useAuth } from "@/context/AuthContext";
import { Mail, Lock, Loader2 } from "lucide-react";

function LoginContent() {
  const router = useRouter();
  const { signIn, signInWithGoogle } = useAuth();

  const [email, setEmail] = useState("");
  const [password, setPassword] = useState("");
  const [loading, setLoading] = useState(false);
  const [googleLoading, setGoogleLoading] = useState(false);
  const [error, setError] = useState("");

  const searchParams = useSearchParams();

  const getRedirectPath = () => {
    const next = searchParams.get("next");

    if (!next || !next.startsWith("/") || next.startsWith("//")) {
      return "/";
    }

    return next;
  };

  const handleLogin = async (e: FormEvent<HTMLFormElement>) => {
    e.preventDefault();
    setError("");
    setLoading(true);

    const { error } = await signIn(email, password);

    if (error) {
      setError(error.message);
      setLoading(false);
      return;
    }

    router.replace(getRedirectPath());
    router.refresh();
  };

  const handleGoogleLogin = async () => {
    setError("");
    setGoogleLoading(true);

    const { error } = await signInWithGoogle(getRedirectPath());

    if (error) {
      setError(error.message);
      setGoogleLoading(false);
    }
  };

  return (
    <main className="flex min-h-[calc(100vh-68px)] items-center justify-center bg-[#FFF8EB] px-4 py-12">
      <div className="w-full max-w-md rounded-3xl border border-[#EADCC9] bg-white p-7 shadow-xl sm:p-9">
        <div className="mb-8 text-center">
          <h1 className="text-3xl font-bold text-[#38231C]">
            Welcome Back!
          </h1>
          <p className="mt-2 text-sm text-[#806B5D]">
            Sign in to continue your UtsavZero journey.
          </p>
        </div>

        <button
          type="button"
          onClick={handleGoogleLogin}
          disabled={googleLoading || loading}
          className="flex w-full items-center justify-center gap-3 rounded-xl border border-[#EADCC9] px-4 py-3 font-medium text-[#38231C] transition hover:bg-[#FFF8EB] disabled:opacity-60"
        >
          {googleLoading ? (
            <Loader2 className="animate-spin" size={20} />
          ) : (
            <svg viewBox="0 0 48 48" className="h-5 w-5">
              <path fill="#EA4335" d="M24 9.5c3.5 0 6.6 1.2 9 3.5l6.7-6.7C35.6 2.4 30.3 0 24 0 14.6 0 6.5 5.4 2.6 13.2l7.8 6.1C12.3 13.6 17.7 9.5 24 9.5Z" />
              <path fill="#4285F4" d="M46.1 24.5c0-1.6-.2-3.2-.5-4.7H24v9h12.4c-.6 3-2.3 5.5-4.8 7.2l7.5 5.8c4.4-4.1 7-10.1 7-17.3Z" />
              <path fill="#FBBC05" d="M10.4 28.7c-.5-1.4-.8-3-.8-4.7s.3-3.2.8-4.7l-7.8-6.1C.9 16.6 0 20.2 0 24s.9 7.4 2.6 10.8l7.8-6.1Z" />
              <path fill="#34A853" d="M24 48c6.3 0 11.6-2.1 15.4-5.8l-7.5-5.8c-2.1 1.4-4.8 2.2-7.9 2.2-6.3 0-11.7-4.1-13.6-9.8l-7.8 6.1C6.5 42.6 14.6 48 24 48Z" />
            </svg>
          )}
          Continue with Google
        </button>

        <div className="my-6 flex items-center gap-4">
          <div className="h-px flex-1 bg-[#EADCC9]" />
          <span className="text-xs text-[#806B5D]">
            OR CONTINUE WITH EMAIL
          </span>
          <div className="h-px flex-1 bg-[#EADCC9]" />
        </div>

        <form onSubmit={handleLogin} className="space-y-5">
          <div>
            <label htmlFor="email" className="mb-2 block text-sm font-medium text-[#38231C]">
              Email address
            </label>
            <div className="flex items-center gap-3 rounded-xl border border-[#EADCC9] px-4">
              <Mail size={18} className="text-[#806B5D]" />
              <input
                id="email"
                type="email"
                required
                autoComplete="email"
                value={email}
                onChange={(e) => setEmail(e.target.value)}
                placeholder="you@example.com"
                className="w-full bg-transparent py-3 text-sm text-[#38231C] outline-none"
              />
            </div>
          </div>

          <div>
            <label htmlFor="password" className="mb-2 block text-sm font-medium text-[#38231C]">
              Password
            </label>
            <div className="flex items-center gap-3 rounded-xl border border-[#EADCC9] px-4">
              <Lock size={18} className="text-[#806B5D]" />
              <input
                id="password"
                type="password"
                required
                autoComplete="current-password"
                value={password}
                onChange={(e) => setPassword(e.target.value)}
                placeholder="Enter your password"
                className="w-full bg-transparent py-3 text-sm text-[#38231C] outline-none"
              />
            </div>
          </div>

          {error && (
            <p role="alert" className="rounded-lg bg-red-50 p-3 text-sm text-red-600">
              {error}
            </p>
          )}

          <button
            type="submit"
            disabled={loading || googleLoading}
            className="flex w-full items-center justify-center gap-2 rounded-xl bg-gradient-to-r from-[#FFBE45] via-[#FF6A16] to-[#F0440A] py-3 font-semibold text-white shadow-md transition hover:opacity-90 disabled:opacity-60"
          >
            {loading && <Loader2 size={19} className="animate-spin" />}
            {loading ? "Signing in..." : "Sign In"}
          </button>
        </form>

        <p className="mt-7 text-center text-sm text-[#806B5D]">
          Don&apos;t have an account?{" "}
          <Link href="/signup" className="font-semibold text-[#F0440A] hover:underline">
            Create Account
          </Link>
        </p>
      </div>
    </main>
  );
}

export default function LoginPage() {
  return (
    <Suspense
      fallback={
        <main className="flex min-h-[calc(100vh-68px)] items-center justify-center bg-[#FFF8EB]">
          <Loader2 className="animate-spin text-[#F0440A]" size={28} />
        </main>
      }
    >
      <LoginContent />
    </Suspense>
  );
}
</file>

