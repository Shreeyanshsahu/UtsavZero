    if (!allowedGeometryTypes.has(geometry.type)) {
        return false;
    }

    function checkCoordinates(value) {
        if (
            Array.isArray(value) &&
            value.length >= 2 &&
            typeof value[0] === "number" &&
            typeof value[1] === "number"
