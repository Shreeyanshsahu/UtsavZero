import {
  ScanLine,
  CheckCircle2,
  XCircle,
  AlertCircle,
  RefreshCw,
  ShieldCheck,
  TicketCheck,
  Loader2,
} from "lucide-react";

const resultConfig = {
  success: {
    title: "Ticket Verified",
    message: "Check-in successful. This ticket has been marked as used.",
