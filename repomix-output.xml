<file path="src/components/hostevents/organize/LocationSearchInput.tsx">
"use client";

import { useCallback, useEffect, useState } from "react";
import {
  LocateFixed,
  LoaderCircle,
  MapPin,
  Search,
} from "lucide-react";
import { useTheme } from "@/context/ThemeContext";

export interface NominatimResult {
  id: string;
  name: string;
  address: string;
  formatted: string;
  lat: number;
  lon: number;
  distance: number | null;
  resultType: string;
}

interface LocationSearchInputProps {
  onSelect: (result: NominatimResult) => void;
  onCurrentLocationDetected?: (
    latitude: number,
    longitude: number
  ) => void;
}

interface AutocompleteResponse {
  results?: NominatimResult[];
  error?: string;
}

export default function LocationSearchInput({
  onSelect,
  onCurrentLocationDetected,
}: LocationSearchInputProps) {
  const { isDarkMode } = useTheme();

  const [query, setQuery] = useState("");
  const [results, setResults] = useState<NominatimResult[]>([]);

  const [latitude, setLatitude] = useState<number | null>(null);
  const [longitude, setLongitude] = useState<number | null>(null);

  const [loading, setLoading] = useState(false);
  const [locating, setLocating] = useState(false);

  const [locationMessage, setLocationMessage] = useState("");
  const [error, setError] = useState("");
  const [showResults, setShowResults] = useState(false);

  const textClass = isDarkMode
    ? "text-[#FFF8EB]"
    : "text-[#38231C]";

  const mutedClass = isDarkMode
    ? "text-[#B7B0A5]"
    : "text-[#806B5D]";

  const inputClass = isDarkMode
    ? "border-[#454C47] bg-[#292E2B] text-[#FFF8EB] placeholder:text-[#8F968F]"
    : "border-[#EADCC9] bg-white text-[#38231C] placeholder:text-[#A39486]";

  const cardClass = isDarkMode
    ? "border-[#454C47] bg-[#292E2B]"
    : "border-[#EADCC9] bg-white";

  // Detect the user's current location.
  // Handle successful location detection.
function handleLocationSuccess(position: GeolocationPosition) {
  setLatitude(position.coords.latitude);
  setLongitude(position.coords.longitude);
  setLocating(false);
  setLocationMessage("Searching near your current location.");
  onCurrentLocationDetected?.(
  position.coords.latitude,
  position.coords.longitude
);
}

// Handle location detection errors.
function handleLocationError(error: GeolocationPositionError) {
  setLocating(false);

  if (error.code === error.PERMISSION_DENIED) {
    setLocationMessage(
      "Location permission denied. You can still search manually."
    );
  } else if (error.code === error.TIMEOUT) {
    setLocationMessage(
      "Location request timed out. Please try again."
    );
  } else {
    setLocationMessage(
      "Couldn't detect your location. You can search manually."
    );
  }
}

// Automatically request location when the picker opens.
useEffect(() => {
  if (!navigator.geolocation) {
    return;
  }

  navigator.geolocation.getCurrentPosition(
    handleLocationSuccess,
    handleLocationError,
    {
      enableHighAccuracy: true,
      timeout: 12000,
      maximumAge: 60000,
    }
  );
}, []);
const requestCurrentLocation = () => {
  if (!navigator.geolocation) {
    setLocationMessage(
      "Location detection is not supported by this browser."
    );
    return;
  }

  setLocating(true);
  setLocationMessage("");

  navigator.geolocation.getCurrentPosition(
    handleLocationSuccess,
    handleLocationError,
    {
      enableHighAccuracy: true,
      timeout: 12000,
      maximumAge: 60000,
    }
  );
};
  // Live autocomplete with a 350ms debounce.
  useEffect(() => {
    const trimmedQuery = query.trim();

    if (trimmedQuery.length < 2) {
      return;
    }

    const controller = new AbortController();

    const timeout = setTimeout(async () => {
      setLoading(true);
      setError("");

      try {
        const params = new URLSearchParams({
          text: trimmedQuery,
        });

        if (latitude !== null && longitude !== null) {
          params.set("lat", String(latitude));
          params.set("lon", String(longitude));
        }

        const response = await fetch(
          `/api/places/autocomplete?${params.toString()}`,
          { signal: controller.signal }
        );

        const data: AutocompleteResponse = await response.json();

        if (!response.ok) {
          throw new Error(
            data.error || "Location search failed."
          );
        }

        setResults(data.results ?? []);
        setShowResults(true);
      } catch (err) {
        if (err instanceof Error && err.name === "AbortError") {
          return;
        }

        setError(
          err instanceof Error
            ? err.message
            : "Unable to search locations."
        );

        setResults([]);
      } finally {
        if (!controller.signal.aborted) {
          setLoading(false);
        }
      }
    }, 350);

    return () => {
      clearTimeout(timeout);
      controller.abort();
    };
  }, [query, latitude, longitude]);

  function handleQueryChange(value: string) {
    setQuery(value);
    setShowResults(true);

    // Clear previous results immediately.
    setResults([]);
    setError("");
    setLoading(false);
  }

  function handleSelect(result: NominatimResult) {
    setQuery(result.name);
    setShowResults(false);
    setResults([]);

    onSelect(result);
  }

  function formatDistance(distance: number | null) {
    if (distance === null || !Number.isFinite(distance)) {
      return "";
    }

    return distance < 1000
      ? `${Math.round(distance)} m away`
      : `${(distance / 1000).toFixed(1)} km away`;
  }

  return (
    <div className="relative space-y-3">
      {/* Search input */}
      <div className="relative">
        <Search
          size={18}
          className={`absolute left-3 top-1/2 -translate-y-1/2 ${mutedClass}`}
        />

        <input
          type="text"
          value={query}
          onChange={(event) =>
            handleQueryChange(event.target.value)
          }
          onFocus={() => setShowResults(true)}
          placeholder="Search school, college, park, venue..."
          autoComplete="off"
          className={`w-full rounded-xl border py-3 pl-10 pr-11 text-sm outline-none focus:border-[#F0440A] focus:ring-1 focus:ring-[#F0440A] ${inputClass}`}
        />

        {loading && (
          <LoaderCircle
            size={18}
            className="absolute right-3 top-1/2 -translate-y-1/2 animate-spin text-[#F0440A]"
          />
        )}
      </div>

      {/* Current location */}
      <button
        type="button"
        onClick={requestCurrentLocation}
        disabled={locating}
        className={`flex w-full items-center justify-center gap-2 rounded-xl border p-3 text-sm font-semibold transition hover:border-[#F0440A] ${cardClass} ${textClass}`}
      >
        {locating ? (
          <LoaderCircle size={17} className="animate-spin" />
        ) : (
          <LocateFixed
            size={17}
            className="text-[#F0440A]"
          />
        )}

        {locating
          ? "Detecting your location..."
          : "Use my current location"}
      </button>

      {locationMessage && (
        <p className={`text-xs ${mutedClass}`}>
          {locationMessage}
        </p>
      )}

      {error && (
        <p className="text-xs text-red-500">{error}</p>
      )}

      {query.trim().length === 1 && (
        <p className={`text-xs ${mutedClass}`}>
          Type at least 2 characters to search.
        </p>
      )}

      {/* Autocomplete suggestions */}
      {showResults && results.length > 0 && (
        <div
          className={`absolute left-0 right-0 z-[1000] max-h-72 overflow-y-auto rounded-xl border shadow-xl ${cardClass}`}
        >
          {results.map((result) => (
            <button
              key={result.id}
              type="button"
              onMouseDown={(event) => event.preventDefault()}
              onClick={() => handleSelect(result)}
              className="flex w-full items-start gap-3 border-b p-3 text-left last:border-b-0 hover:bg-[#F0440A]/10"
            >
              <MapPin
                size={18}
                className="mt-1 shrink-0 text-[#F0440A]"
              />

              <span className="min-w-0 flex-1">
                <span
                  className={`block text-sm font-semibold ${textClass}`}
                >
                  {result.name}
                </span>

                <span
                  className={`mt-1 block text-xs ${mutedClass}`}
                >
                  {result.address}
                </span>

                {result.distance !== null && (
                  <span className="mt-1 block text-xs text-[#F0440A]">
                    {formatDistance(result.distance)}
                  </span>
                )}
              </span>
            </button>
          ))}
        </div>
      )}

      {showResults &&
        !loading &&
        query.trim().length >= 2 &&
        results.length === 0 &&
        !error && (
          <p className={`text-xs ${mutedClass}`}>
            No locations found. Try a different search.
          </p>
        )}
    </div>
  );
}
</file>

<file path="src/components/hostevents/registrations/BookingDetails.tsx">
"use client";

import {
  X,
  User,
  Mail,
  Phone,
  CalendarDays,
  MapPin,
  Users,
  Ticket,
  CreditCard,
  Clock,
  CheckCircle2,
  XCircle,
} from "lucide-react";

import { useTheme } from "@/context/ThemeContext";

import type {
  OrganizerRegistration,
} from "@/services/hostevents/registrationService";

interface BookingDetailsProps {
  registration: OrganizerRegistration | null;
  onClose: () => void;
}

function formatDate(date: string) {
  return new Date(date).toLocaleString("en-IN", {
    day: "numeric",
    month: "long",
    year: "numeric",
    hour: "numeric",
    minute: "2-digit",
  });
}

function formatCurrency(amount: number, currency: string) {
  return new Intl.NumberFormat("en-IN", {
    style: "currency",
    currency: currency || "INR",
    maximumFractionDigits: 2,
  }).format(amount);
}

export default function BookingDetails({
  registration,
  onClose,
}: BookingDetailsProps) {
  const { isDarkMode } = useTheme();

  if (!registration) {
    return null;
  }

  const isCheckedIn =
    registration.ticket?.status === "checked_in";

  const cardClass = isDarkMode
    ? "border-[#34463A] bg-[#202C24]"
    : "border-[#E9E8DF] bg-white";

  const headingClass = isDarkMode
    ? "text-[#FFF8EB]"
    : "text-[#38231C]";

  const secondaryClass = isDarkMode
    ? "text-[#AFAFA5]"
    : "text-[#806B5D]";

  const detailRows = [
    {
      label: "Attendee name",
      value: registration.attendee_name,
      icon: User,
    },
    {
      label: "Email address",
      value: registration.attendee_email,
      icon: Mail,
    },
    {
      label: "Phone number",
      value: registration.attendee_phone || "Not provided",
      icon: Phone,
    },
    {
      label: "Event",
      value: registration.event.title,
      icon: MapPin,
    },
    {
      label: "Event date",
      value: formatDate(registration.event.starts_at),
      icon: CalendarDays,
    },
    {
      label: "Booking date",
      value: formatDate(registration.created_at),
      icon: Clock,
    },
    {
      label: "Participants",
      value: `${registration.quantity} attendee${
        registration.quantity !== 1 ? "s" : ""
      }`,
      icon: Users,
    },
    {
      label: "Booking reference",
      value: registration.booking_reference,
      icon: Ticket,
    },
  ];

  return (
    <div
      className="fixed inset-0 z-[100] flex items-center justify-center bg-black/60 p-3 backdrop-blur-sm sm:p-6"
      onClick={onClose}
    >
      <div
        role="dialog"
        aria-modal="true"
        aria-labelledby="booking-details-title"
        className={`max-h-[90vh] w-full max-w-2xl overflow-y-auto rounded-2xl border shadow-2xl ${cardClass}`}
        onClick={(event) => event.stopPropagation()}
      >
        {/* Header */}
        <div
          className={`sticky top-0 z-10 flex items-center justify-between border-b p-5 ${
            isDarkMode
              ? "border-[#34463A] bg-[#202C24]"
              : "border-[#E9E8DF] bg-white"
          }`}
        >
          <div>
            <h2
              id="booking-details-title"
              className={`text-xl font-bold ${headingClass}`}
            >
              Registration Details
            </h2>

            <p className={`mt-1 text-xs ${secondaryClass}`}>
              Booking reference: {registration.booking_reference}
            </p>
          </div>

          <button
            type="button"
            onClick={onClose}
            aria-label="Close registration details"
            className={`rounded-xl p-2 transition-colors ${
              isDarkMode
                ? "text-[#B7B0A5] hover:bg-[#34463A]"
                : "text-[#806B5D] hover:bg-[#F0F3EC]"
            }`}
          >
            <X size={20} />
          </button>
        </div>

        <div className="space-y-5 p-5">
          {/* Attendee information */}
          <section>
            <h3 className={`mb-3 text-sm font-bold ${headingClass}`}>
              Attendee Information
            </h3>

            <div className="grid grid-cols-1 gap-3 sm:grid-cols-2">
              {detailRows.slice(0, 3).map((item) => {
                const Icon = item.icon;

                return (
                  <div
                    key={item.label}
                    className={`rounded-xl border p-3 ${cardClass}`}
                  >
                    <div className="mb-2 flex items-center gap-2">
                      <Icon size={15} className="text-[#72977A]" />
                      <span className={`text-xs ${secondaryClass}`}>
                        {item.label}
                      </span>
                    </div>

                    <p className={`break-words text-sm font-semibold ${headingClass}`}>
                      {item.value}
                    </p>
                  </div>
                );
              })}
            </div>
          </section>

          {/* Event and booking information */}
          <section>
            <h3 className={`mb-3 text-sm font-bold ${headingClass}`}>
              Event & Booking Information
            </h3>

            <div className={`divide-y rounded-xl border px-4 ${cardClass}`}>
              {detailRows.slice(3).map((item) => {
                const Icon = item.icon;

                return (
                  <div
                    key={item.label}
                    className={`flex items-start gap-3 py-3 ${
                      isDarkMode
                        ? "border-[#34463A]"
                        : "border-[#F0EFE8]"
                    }`}
                  >
                    <Icon
                      size={16}
                      className="mt-0.5 shrink-0 text-[#72977A]"
                    />

                    <div className="min-w-0">
                      <p className={`text-xs ${secondaryClass}`}>
                        {item.label}
                      </p>

                      <p className={`mt-1 break-words text-sm font-medium ${headingClass}`}>
                        {item.value}
                      </p>
                    </div>
                  </div>
                );
              })}
            </div>
          </section>

          {/* Payment information */}
          <section>
            <h3 className={`mb-3 text-sm font-bold ${headingClass}`}>
              Payment Information
            </h3>

            <div className={`rounded-xl border p-4 ${cardClass}`}>
              <div className="mb-3 flex items-center gap-2">
                <CreditCard size={17} className="text-[#72977A]" />
                <span className={`text-sm font-semibold ${headingClass}`}>
                  Payment Summary
                </span>
              </div>

              <div className="space-y-2">
                <div className="flex justify-between gap-3 text-sm">
                  <span className={secondaryClass}>Price per attendee</span>
                  <span className={headingClass}>
                    {formatCurrency(
                      registration.unit_price,
                      registration.currency
                    )}
                  </span>
                </div>

                <div className="flex justify-between gap-3 text-sm">
                  <span className={secondaryClass}>Participants</span>
                  <span className={headingClass}>
                    {registration.quantity}
                  </span>
                </div>

                <div
                  className={`flex justify-between gap-3 border-t pt-3 ${
                    isDarkMode
                      ? "border-[#34463A]"
                      : "border-[#E9E8DF]"
                  }`}
                >
                  <span className={`font-semibold ${headingClass}`}>
                    Total amount
                  </span>

                  <span className={`font-bold ${headingClass}`}>
                    {formatCurrency(
                      registration.total_amount,
                      registration.currency
                    )}
                  </span>
                </div>

                <div className="flex justify-between gap-3 pt-1 text-sm">
                  <span className={secondaryClass}>Payment status</span>
                  <span className={`font-semibold capitalize ${headingClass}`}>
                    {registration.payment_status.replaceAll("_", " ")}
                  </span>
                </div>
              </div>
            </div>
          </section>

          {/* Ticket information */}
          <section>
            <h3 className={`mb-3 text-sm font-bold ${headingClass}`}>
              Ticket & Check-in
            </h3>

            <div className={`rounded-xl border p-4 ${cardClass}`}>
              {registration.ticket ? (
                <>
                  <div className="flex items-start justify-between gap-3">
                    <div>
                      <p className={`text-xs ${secondaryClass}`}>
                        Ticket number
                      </p>

                      <p className={`mt-1 font-mono text-sm font-bold ${headingClass}`}>
                        {registration.ticket.ticket_number}
                      </p>
                    </div>

                    <span
                      className={`rounded-full px-3 py-1 text-xs font-semibold ${
                        isCheckedIn
                          ? "bg-emerald-500/10 text-emerald-500"
                          : "bg-orange-500/10 text-orange-500"
                      }`}
                    >
                      {registration.ticket.status.replaceAll("_", " ")}
                    </span>
                  </div>

                  <div
                    className={`mt-4 flex items-center gap-2 text-sm ${
                      isCheckedIn
                        ? "text-emerald-500"
                        : secondaryClass
                    }`}
                  >
                    {isCheckedIn ? (
                      <CheckCircle2 size={17} />
                    ) : (
                      <Clock size={17} />
                    )}

                    {isCheckedIn
                      ? `Checked in on ${formatDate(
                          registration.ticket.checked_in_at ||
                            registration.ticket.issued_at
                        )}`
                      : "This group ticket has not been checked in."}
                  </div>
                </>
              ) : (
                <div className="flex items-center gap-2 text-sm">
                  <XCircle size={17} className="text-orange-500" />
                  <span className={secondaryClass}>
                    No ticket information is available for this booking.
                  </span>
                </div>
              )}
            </div>
          </section>
        </div>

        {/* Footer */}
        <div
          className={`flex justify-end border-t p-5 ${
            isDarkMode
              ? "border-[#34463A]"
              : "border-[#E9E8DF]"
          }`}
        >
          <button
            type="button"
            onClick={onClose}
            className="rounded-xl bg-[#52765B] px-5 py-2.5 text-sm font-semibold text-white transition-colors hover:bg-[#416249]"
          >
            Close
          </button>
        </div>
      </div>
    </div>
  );
}
</file>

