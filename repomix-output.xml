<file path="src/app/organizer/registrations/page.tsx">
"use client";

import { useMemo, useState } from "react";
import { AlertCircle, RefreshCw } from "lucide-react";

import OrganizerLayout from "@/components/hostevents/layout/OrganizerLayout";
import RegistrationStats from "@/components/hostevents/registrations/RegistrationStats";
import RegistrationFilters from "@/components/hostevents/registrations/RegistrationFilters";
import RegistrationTable from "@/components/hostevents/registrations/RegistrationTable";
import BookingDetails from "@/components/hostevents/registrations/BookingDetails";

import { useRegistrations } from "@/hooks/hostevents/useRegistrations";
import { useTheme } from "@/context/ThemeContext";

import type {
  OrganizerRegistration,
  RegistrationEvent,
} from "@/services/hostevents/registrationService";

export default function RegistrationsPage() {
  const { isDarkMode } = useTheme();

  // Fetch registration data.
  const {
    registrations,
    loading,
    error,
    refresh,
  } = useRegistrations();

  // Search and filter state.
  const [searchQuery, setSearchQuery] = useState("");
  const [selectedEvent, setSelectedEvent] = useState("all");
  const [selectedStatus, setSelectedStatus] = useState("all");

  // Currently selected registration for the details modal.
  const [selectedRegistration, setSelectedRegistration] =
    useState<OrganizerRegistration | null>(null);

  // Extract unique events from the loaded registrations.
  const events = useMemo<RegistrationEvent[]>(() => {
    const eventMap = new Map<string, RegistrationEvent>();

    registrations.forEach((registration) => {
      eventMap.set(registration.event.id, registration.event);
    });

    return Array.from(eventMap.values());
  }, [registrations]);

  // Apply search and filters.
  const filteredRegistrations = useMemo(() => {
    const query = searchQuery.trim().toLowerCase();

    return registrations.filter((registration) => {
      // Search by attendee, email, booking reference or ticket.
      const matchesSearch =
        query === "" ||
        registration.attendee_name.toLowerCase().includes(query) ||
        registration.attendee_email.toLowerCase().includes(query) ||
        registration.booking_reference.toLowerCase().includes(query) ||
        registration.event.title.toLowerCase().includes(query) ||
        (registration.ticket?.ticket_number ?? "")
          .toLowerCase()
          .includes(query);

      // Filter by event.
      const matchesEvent =
        selectedEvent === "all" ||
        registration.event_id === selectedEvent;

      // Filter by booking status.
      const matchesStatus =
        selectedStatus === "all" ||
        registration.status === selectedStatus;

      return matchesSearch && matchesEvent && matchesStatus;
    });
  }, [
    registrations,
    searchQuery,
    selectedEvent,
    selectedStatus,
  ]);

  const handleViewDetails = (
    registration: OrganizerRegistration
  ) => {
    setSelectedRegistration(registration);
  };

  return (
    <OrganizerLayout
      title="Registrations"
      description="Manage attendee registrations and group bookings for your events."
    >
      <div className="space-y-5">

        {/* Refresh action */}
        <div className="flex justify-end">
          <button
            type="button"
            onClick={() => void refresh()}
            disabled={loading}
            className={`inline-flex items-center gap-2 rounded-xl border px-4 py-2.5 text-sm font-semibold transition-colors disabled:cursor-not-allowed disabled:opacity-60 ${
              isDarkMode
                ? "border-[#34463A] bg-[#22372A] text-[#C0D0C3] hover:bg-[#294333]"
                : "border-[#E4EAE1] bg-white text-[#52675A] hover:bg-[#F3F6F1]"
            }`}
          >
            <RefreshCw
              size={16}
              className={loading ? "animate-spin" : ""}
            />
            {loading ? "Loading..." : "Refresh"}
          </button>
        </div>

        {/* Error state */}
        {error && (
          <div
            className={`flex flex-col gap-3 rounded-xl border p-4 sm:flex-row sm:items-center sm:justify-between ${
              isDarkMode
                ? "border-red-500/30 bg-red-500/10"
                : "border-red-200 bg-red-50"
            }`}
          >
            <div className="flex items-start gap-3">
              <AlertCircle
                size={20}
                className="mt-0.5 shrink-0 text-red-500"
              />

              <div>
                <p className="text-sm font-semibold text-red-500">
                  Unable to load registrations
                </p>

                <p className="mt-1 text-sm text-red-500/80">
                  {error}
                </p>
              </div>
            </div>

            <button
              type="button"
              onClick={() => void refresh()}
              disabled={loading}
              className="self-start rounded-lg bg-red-500 px-4 py-2 text-xs font-semibold text-white transition-colors hover:bg-red-600 disabled:opacity-50 sm:self-center"
            >
              Try again
            </button>
          </div>
        )}

        {/* Loading state */}
        {loading && registrations.length === 0 ? (
          <div
            className={`rounded-2xl border p-12 text-center ${
              isDarkMode
                ? "border-[#34463A] bg-[#202C24]"
                : "border-[#E9E8DF] bg-white"
            }`}
          >
            <RefreshCw
              size={28}
              className="mx-auto animate-spin text-[#72977A]"
            />

            <p
              className={`mt-4 text-sm font-medium ${
                isDarkMode
                  ? "text-[#FFF8EB]"
                  : "text-[#38231C]"
              }`}
            >
              Loading your registrations...
            </p>
          </div>
        ) : (
          <>
            {/* Statistics */}
            <RegistrationStats
              registrations={registrations}
            />

            {/* Filters */}
            <RegistrationFilters
              events={events}
              searchQuery={searchQuery}
              onSearchChange={setSearchQuery}
              selectedEvent={selectedEvent}
              onEventChange={setSelectedEvent}
              selectedStatus={selectedStatus}
              onStatusChange={setSelectedStatus}
            />

            {/* Registrations table */}
            <RegistrationTable
              registrations={filteredRegistrations}
              onViewDetails={handleViewDetails}
            />
          </>
        )}

        {/* Booking details modal */}
        <BookingDetails
          registration={selectedRegistration}
          onClose={() => setSelectedRegistration(null)}
        />

      </div>
    </OrganizerLayout>
  );
}
</file>

<file path="src/app/signup/page.tsx">
"use client";

import { Suspense, useState, type FormEvent } from "react";
import Link from "next/link";
import { useRouter, useSearchParams } from "next/navigation";
import {
  ArrowLeft,
  ArrowRight,
  UserRound,
  Building2,
  ShieldCheck,
  Mail,
  Lock,
  Loader2,
} from "lucide-react";
import { useAuth, type SignupRole } from "@/context/AuthContext";

const accountTypes: {
  role: SignupRole;
  title: string;
  description: string;
  icon: typeof UserRound;
  note: string;
}[] = [
  {
    role: "citizen",
    title: "Citizen",
    description: "Discover events, book tickets and participate in cleaner celebrations.",
    icon: UserRound,
    note: "Create your personal UtsavZero account.",
  },
  {
    role: "government_personnel",
    title: "Government Personnel",
    description: "Apply for verified government organizer access.",
    icon: ShieldCheck,
    note: "Government access requires review and approval by the designated reviewer.",
  },
  {
    role: "private_organizer",
    title: "Private Organizer",
    description: "Host and manage private, firecracker-free community events.",
    icon: Building2,
    note: "You can manage events after registration.",
  },
];

function SignupContent() {
  const router = useRouter();
  const searchParams = useSearchParams();
  const { signUp, signInWithGoogle } = useAuth();

  const roleParam = searchParams.get("role");

  const selectedRole = accountTypes.find(
    (item) => item.role === roleParam
  )?.role;

  const [fullName, setFullName] = useState("");
  const [email, setEmail] = useState("");
  const [password, setPassword] = useState("");
  const [confirmPassword, setConfirmPassword] = useState("");

  const [loading, setLoading] = useState(false);
  const [googleLoading, setGoogleLoading] = useState(false);
  const [error, setError] = useState("");

  const handleSignup = async (event: FormEvent<HTMLFormElement>) => {
    event.preventDefault();
    setError("");

    if (!selectedRole) return;

    if (password.length < 8) {
      setError("Password must contain at least 8 characters.");
      return;
    }

    if (password !== confirmPassword) {
      setError("Passwords do not match.");
      return;
    }

    setLoading(true);

    try {
      const result = await signUp(
        email.trim(),
        password,
        fullName.trim(),
        selectedRole
      );

      if (result.error) {
        setError(result.error.message);
        return;
      }

      const destination =
        selectedRole === "government_personnel"
          ? "/government-authorization/apply"
          : selectedRole === "private_organizer"
          ? "/organizer"
          : "/profile";

      if (result.session && result.user) {
        router.replace(destination);
        router.refresh();
        return;
      }

      if (result.user && !result.session) {
        router.replace(
          `/verify-email?email=${encodeURIComponent(email.trim())}`
        );
        return;
      }

      setError("Signup could not be completed. Please try again.");
    } catch (err) {
      console.error("Signup error:", err);
      setError("Something went wrong. Please try again.");
    } finally {
      setLoading(false);
    }
  };

  const handleGoogleSignup = async () => {
    setError("");
    setGoogleLoading(true);

    try {
      const { error } = await signInWithGoogle("/profile");

      if (error) {
        setError(error.message);
        setGoogleLoading(false);
      }
    } catch (err) {
      console.error("Google signup error:", err);
      setError("Unable to start Google sign-in. Please try again.");
      setGoogleLoading(false);
    }
  };

  return (
    <main className="flex min-h-[calc(100vh-68px)] items-center justify-center bg-[#FFF8EB] px-4 py-12">
      <div className="w-full max-w-xl rounded-3xl border border-[#EADCC9] bg-white p-6 shadow-xl sm:p-9">

        {!selectedRole ? (
          <>
            <div className="mb-8 text-center">
              <p className="mb-3 text-xs font-bold uppercase tracking-[0.2em] text-[#F0440A]">
                Welcome to UtsavZero
              </p>

              <h1 className="text-3xl font-bold text-[#38231C]">
                Join the celebration
              </h1>

              <p className="mt-3 text-sm leading-6 text-[#806B5D]">
                Choose how you want to participate in cleaner celebrations.
              </p>
            </div>

            <div className="space-y-3">
              {accountTypes.map((account) => {
                const Icon = account.icon;

                return (
                  <Link
                    key={account.role}
                    href={`/signup?role=${account.role}`}
                    className="group flex items-center gap-4 rounded-2xl border border-[#EADCC9] p-4 transition hover:border-[#F0440A] hover:bg-[#FFF8EB] sm:p-5"
                  >
                    <div className="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl bg-[#FFF0D8] text-[#F0440A]">
                      <Icon size={23} />
                    </div>

                    <div className="min-w-0 flex-1">
                      <h2 className="font-semibold text-[#38231C]">
                        {account.title}
                      </h2>
                      <p className="mt-1 text-xs leading-5 text-[#806B5D]">
                        {account.description}
                      </p>
                    </div>

                    <ArrowRight
                      size={20}
                      className="shrink-0 text-[#A58B78] transition group-hover:translate-x-1 group-hover:text-[#F0440A]"
                    />
                  </Link>
                );
              })}
            </div>
          </>
        ) : (
          <>
            <Link
              href="/signup"
              className="mb-6 inline-flex items-center gap-2 text-sm font-medium text-[#806B5D] hover:text-[#F0440A]"
            >
              <ArrowLeft size={16} />
              Change account type
            </Link>

            <div className="mb-7">
              <p className="text-xs font-bold uppercase tracking-[0.18em] text-[#F0440A]">
                Create your account
              </p>

              <h1 className="mt-2 text-3xl font-bold text-[#38231C]">
                {accountTypes.find((item) => item.role === selectedRole)?.title}
              </h1>

              <p className="mt-2 text-sm leading-6 text-[#806B5D]">
                {accountTypes.find((item) => item.role === selectedRole)?.note}
              </p>
            </div>

            {selectedRole === "citizen" && (
              <>
                <button
                  type="button"
                  onClick={handleGoogleSignup}
                  disabled={googleLoading || loading}
                  className="flex w-full items-center justify-center gap-3 rounded-xl border border-[#EADCC9] px-4 py-3 font-medium text-[#38231C] transition hover:bg-[#FFF8EB] disabled:opacity-60"
                >
                  {googleLoading ? (
                    <Loader2 className="animate-spin" size={20} />
