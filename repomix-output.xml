    label: "Recorded Decisions",
    description: "Simulated review outcomes",
    icon: ClipboardCheck,
  },
] satisfies {
  key: keyof CivicDashboardStats;
  label: string;
  description: string;
  icon: React.ElementType;
}[];

interface StatCardProps {
  label: string;
  description: string;
  value: number;
  icon: React.ElementType;
