  const supabase = createClient();

  // Fetch exact row counts without downloading table records.
  const [
    localitiesResult,
    featuresResult,
    zonesResult,
    applicationsResult,
    decisionsResult,
  ] = await Promise.all([
    supabase
      .from("localities")
      .select("id", { count: "exact", head: true }),

    supabase
      .from("geographic_features")
      .select("id", { count: "exact", head: true }),

    supabase
      .from("proposed_zones")
      .select("id", { count: "exact", head: true }),

    supabase
      .from("zone_applications")
      .select("id", { count: "exact", head: true }),

    supabase
      .from("zone_decisions")
      .select("id", { count: "exact", head: true }),
