function isValidGeometry(geometry) {
    if (!geometry || !Array.isArray(geometry.coordinates)) {
        return false;
    }

    const allowedGeometryTypes = new Set([
        "Point",
        "LineString",
        "Polygon",
        "MultiPoint",
        "MultiLineString",
        "MultiPolygon",
