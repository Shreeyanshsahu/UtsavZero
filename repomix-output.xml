    "classified",
    `ward-${WARD_ID}-classified-preview.geojson`
);

const LEGACY_INPUT_FILE = path.join(
    OSM_DIR,
    `ward-${WARD_ID}-classified-preview.geojson`
);

const APPLY = process.argv.includes("--apply");
