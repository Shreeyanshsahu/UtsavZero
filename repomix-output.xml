      className={`group w-full min-w-0 overflow-hidden rounded-xl border transition-all duration-300 ${
        isDarkMode
          ? "border-[#333B36] bg-[#222826] shadow-[0_2px_4px_rgba(0,0,0,0.5)]"
          : "border-[#EADCC9] bg-white shadow-sm hover:shadow-md"
      } ${
        onClick
