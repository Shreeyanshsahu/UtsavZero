<file path="src/app/organizer/page.tsx">
"use client";

import { useCallback, useEffect, useState } from "react";
import Link from "next/link";
import OrganizerLayout from "@/components/hostevents/layout/OrganizerLayout";
import { useTheme } from "@/context/ThemeContext";
import { createClient } from "@/lib/supabase/client";
import {
  CalendarDays,
  Users,
  UsersRound,
  Plus,
  ArrowRight,
  CalendarPlus,
  MapPin,
  RefreshCw,
} from "lucide-react";

type EventStatus = "draft" | "published" | "completed" | "cancelled";

interface OrganizerEvent {
  id: string;
  title: string;
  category: string;
  venue_name: string | null;
  address: string | null;
  starts_at: string;
  ends_at: string;
  capacity: number;
  reserved_count: number;
  status: EventStatus;
}

const filters: { label: string; value: EventStatus }[] = [
  { label: "Published", value: "published" },
  { label: "Drafts", value: "draft" },
  { label: "Completed", value: "completed" },
  { label: "Cancelled", value: "cancelled" },
];

export default function OrganizerPage() {
  const { isDarkMode } = useTheme();

  const [events, setEvents] = useState<OrganizerEvent[]>([]);
  const [activeFilter, setActiveFilter] =
    useState<EventStatus>("published");
  const [loading, setLoading] = useState(true);
  const [error, setError] = useState("");

  const fetchEvents = useCallback(async () => {
    setLoading(true);
    setError("");

    try {
      const supabase = createClient();

      const {
        data: { user },
        error: authError,
      } = await supabase.auth.getUser();

      if (authError || !user) {
        throw new Error("Please sign in to view your dashboard.");
      }

      const { data, error: fetchError } = await supabase
        .from("events")
        .select(
          "id, title, category, venue_name, address, starts_at, ends_at, capacity, reserved_count, status"
        )
        .eq("organizer_id", user.id)
        .order("created_at", { ascending: false });

      if (fetchError) throw fetchError;

      setEvents((data ?? []) as OrganizerEvent[]);
    } catch (err) {
      setError(
        err instanceof Error
          ? err.message
          : "Unable to load organizer events."
      );
    } finally {
      setLoading(false);
    }
  }, []);

  useEffect(() => {
    let active = true;

    const load = async () => {
      try {
        const supabase = createClient();

        const {
          data: { user },
          error: authError,
        } = await supabase.auth.getUser();

        if (authError || !user) {
          throw new Error("Please sign in to view your dashboard.");
        }

        const { data, error: fetchError } = await supabase
          .from("events")
          .select(
            "id, title, category, venue_name, address, starts_at, ends_at, capacity, reserved_count, status"
          )
          .eq("organizer_id", user.id)
          .order("created_at", { ascending: false });

        if (fetchError) throw fetchError;

        if (active) setEvents((data ?? []) as OrganizerEvent[]);
      } catch (err) {
        if (active) {
          setError(
            err instanceof Error
              ? err.message
              : "Unable to load organizer events."
          );
        }
      } finally {
        if (active) setLoading(false);
      }
    };

    load();

    return () => {
      active = false;
    };
  }, []);

  const publishedCount = events.filter(
    (event) => event.status === "published"
  ).length;

  const totalRegistrations = events.reduce(
    (total, event) => total + (event.reserved_count || 0),
    0
  );

  const totalCapacity = events.reduce(
    (total, event) => total + (event.capacity || 0),
    0
  );

  const filteredEvents = events.filter(
    (event) => event.status === activeFilter
  );

  const stats = [
    {
      label: "Published events",
      value: publishedCount,
      icon: CalendarDays,
    },
    {
      label: "Registrations",
      value: totalRegistrations,
      icon: Users,
    },
    {
      label: "Total capacity",
      value: totalCapacity,
      icon: UsersRound,
    },
  ];

  const cardStyle = isDarkMode
    ? "border-[#343B36] bg-[#202522]"
    : "border-[#EADCC9] bg-white";

  const headingText = isDarkMode
    ? "text-[#FFF8EB]"
    : "text-[#38231C]";

  const mutedText = isDarkMode
    ? "text-[#B7B0A5]"
    : "text-[#806B5D]";

  const formatDate = (date: string) =>
    new Date(date).toLocaleDateString("en-IN", {
      day: "numeric",
      month: "short",
      year: "numeric",
    });

  const statusStyle: Record<EventStatus, string> = {
    published: isDarkMode
      ? "bg-emerald-950/50 text-emerald-300"
      : "bg-emerald-50 text-emerald-700",
    draft: isDarkMode
      ? "bg-amber-950/50 text-amber-300"
      : "bg-amber-50 text-amber-700",
    completed: isDarkMode
      ? "bg-blue-950/50 text-blue-300"
      : "bg-blue-50 text-blue-700",
    cancelled: isDarkMode
      ? "bg-red-950/50 text-red-300"
      : "bg-red-50 text-red-700",
  };

  return (
    <OrganizerLayout
      title="Organiser Dashboard"
      description="Bring your community together. Manage every celebration from one place."
    >
      {/* Create Event */}
      <div className="mb-7 flex justify-end">
        <Link
          href="/organizer/organize"
          className="inline-flex items-center gap-2 rounded-xl bg-gradient-to-r from-[#FFBE45] via-[#FF6A16] to-[#F0440A] px-5 py-3 text-sm font-semibold text-white shadow-sm transition-opacity hover:opacity-90"
        >
          <Plus size={17} />
          Create Event
          <ArrowRight size={16} />
        </Link>
      </div>

      {/* Statistics */}
      <section className="mb-7 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {stats.map((stat) => {
          const Icon = stat.icon;

          return (
            <div
              key={stat.label}
              className={`rounded-2xl border p-5 shadow-sm ${cardStyle}`}
            >
              <div className="flex items-center gap-3">
                <div className="flex h-9 w-9 items-center justify-center rounded-lg bg-[#FFF0D8] text-[#F0440A]">
                  <Icon size={18} />
                </div>
                <span className={`text-sm ${mutedText}`}>
                  {stat.label}
                </span>
              </div>

              <p className={`mt-3 text-3xl font-bold ${headingText}`}>
                {loading ? "—" : stat.value.toLocaleString("en-IN")}
              </p>
            </div>
          );
        })}
      </section>

      {/* Filters */}
      <section
        className={`mb-6 flex flex-wrap items-center gap-2 border-b pb-4 ${
          isDarkMode
            ? "border-[#343B36]"
            : "border-[#EADCC9]"
        }`}
      >
        {filters.map((filter) => {
          const isActive = activeFilter === filter.value;

          const count = events.filter(
            (event) => event.status === filter.value
          ).length;

          return (
            <button
              key={filter.value}
              type="button"
              onClick={() => setActiveFilter(filter.value)}
              aria-pressed={isActive}
              className={`rounded-full px-4 py-2 text-xs font-semibold transition-all ${
                isActive
                  ? "bg-[#F0440A] text-white shadow-sm"
                  : isDarkMode
                    ? "bg-[#292E2B] text-[#B7B0A5] hover:text-[#FFBE45]"
                    : "bg-[#F5EBDD] text-[#806B5D] hover:text-[#F0440A]"
              }`}
            >
              {filter.label} ({loading ? "—" : count})
            </button>
          );
        })}
      </section>

      {/* Events */}
      <section>
        <div className="mb-4 flex items-center justify-between">
          <h2 className={`font-[var(--font-lora)] text-lg font-bold ${headingText}`}>
            Your Events
          </h2>

          <div className="flex items-center gap-3">
            <button
              type="button"
              onClick={fetchEvents}
              disabled={loading}
              aria-label="Refresh dashboard"
              className={`rounded-lg p-2 transition hover:text-[#F0440A] disabled:opacity-50 ${mutedText}`}
            >
              <RefreshCw
                size={17}
                className={loading ? "animate-spin" : ""}
              />
            </button>

            <Link
              href="/organizer/organize"
              className="text-sm font-semibold text-[#F0440A] hover:underline"
            >
              View all
            </Link>
          </div>
        </div>

        {loading ? (
          <div className={`flex flex-col items-center justify-center rounded-2xl border px-6 py-14 ${cardStyle}`}>
            <RefreshCw size={25} className="animate-spin text-[#F0440A]" />
            <p className={`mt-3 text-sm ${mutedText}`}>
              Loading your events...
            </p>
          </div>
        ) : error ? (
          <div className={`rounded-2xl border border-red-300 p-6 text-sm ${isDarkMode ? "bg-red-950/30 text-red-300" : "bg-red-50 text-red-700"}`}>
            <p>{error}</p>
            <button
              type="button"
              onClick={fetchEvents}
              className="mt-3 font-semibold underline"
            >
              Try again
            </button>
          </div>
        ) : filteredEvents.length === 0 ? (
          <div
            className={`flex flex-col items-center justify-center rounded-2xl border border-dashed px-6 py-14 text-center ${cardStyle}`}
          >
            <div className="mb-4 flex h-14 w-14 items-center justify-center rounded-2xl bg-[#FFF0D8] text-[#F0440A]">
              <CalendarPlus size={27} />
            </div>

            <h3 className={`font-[var(--font-lora)] text-lg font-bold ${headingText}`}>
              No {activeFilter} events yet
            </h3>

            <p className={`mt-2 max-w-md text-sm leading-6 ${mutedText}`}>
              Your {activeFilter} events will appear here when available.
            </p>

            <Link
              href="/organizer/organize"
              className="mt-5 inline-flex items-center gap-2 rounded-xl bg-gradient-to-r from-[#FFBE45] via-[#FF6A16] to-[#F0440A] px-5 py-3 text-sm font-semibold text-white transition-opacity hover:opacity-90"
            >
              <Plus size={16} />
              Create an event
            </Link>
          </div>
        ) : (
          <div className="space-y-4">
            {filteredEvents.map((event) => {
              const available = Math.max(
                0,
                event.capacity - event.reserved_count
              );

              const progress =
                event.capacity > 0
                  ? Math.min(
                      100,
                      (event.reserved_count / event.capacity) * 100
                    )
                  : 0;

              return (
                <article
                  key={event.id}
                  className={`rounded-2xl border p-5 shadow-sm transition hover:shadow-md ${cardStyle}`}
                >
                  <div className="flex flex-wrap items-start justify-between gap-3">
                    <div>
                      <p className="text-xs font-semibold uppercase tracking-wider text-[#F0440A]">
                        {event.category || "Community Event"}
                      </p>

                      <h3 className={`mt-2 text-lg font-bold ${headingText}`}>
                        {event.title}
                      </h3>

                      <div className={`mt-3 flex flex-wrap gap-x-5 gap-y-2 text-sm ${mutedText}`}>
                        <span className="inline-flex items-center gap-2">
                          <CalendarDays size={15} />
                          {formatDate(event.starts_at)}
                        </span>

                        {(event.venue_name || event.address) && (
                          <span className="inline-flex items-center gap-2">
                            <MapPin size={15} />
                            {event.venue_name || event.address}
                          </span>
                        )}
                      </div>
                    </div>

                    <span className={`rounded-full px-3 py-1.5 text-xs font-bold capitalize ${statusStyle[event.status]}`}>
                      {event.status}
                    </span>
                  </div>

                  <div className="mt-5">
                    <div className="mb-2 flex justify-between text-xs">
                      <span className={`font-semibold ${headingText}`}>
                        Registrations
                      </span>
                      <span className={mutedText}>
                        {event.reserved_count} / {event.capacity} seats
                      </span>
                    </div>

                    <div className={`h-2 overflow-hidden rounded-full ${isDarkMode ? "bg-[#343B36]" : "bg-[#F2E9DC]"}`}>
                      <div
                        className="h-full rounded-full bg-gradient-to-r from-[#FFBE45] to-[#F0440A]"
                        style={{ width: `${progress}%` }}
                      />
                    </div>

                    <p className={`mt-2 text-xs ${mutedText}`}>
                      {available} seats remaining
                    </p>
                  </div>
                </article>
              );
            })}
          </div>
        )}
      </section>

      <p className={`mt-6 text-[11px] ${mutedText}`}>
        UtsavZero Organizer Workspace · Statistics are connected to live Supabase event records.
      </p>
    </OrganizerLayout>
  );
}
</file>

<file path="src/app/profile/page.tsx">
"use client";

import { useCallback, useEffect, useState } from "react";
import Link from "next/link";
import {
  CalendarDays,
  MapPin,
  Ticket,
  Users,
  Clock,
  RefreshCw,
  CheckCircle2,
  XCircle,
  AlertCircle,
} from "lucide-react";

import { useAuth } from "@/context/AuthContext";
import { useTheme } from "@/context/ThemeContext";
import Navbar from "@/components/layout/Navbar";
import BookingQRCode from "@/components/Events/Ticket/BookingQRCode";
import {
  getMyTickets,
  type MyTicket,
} from "@/services/booking/myTicketsService";

function getTicketStatus(ticket: MyTicket) {
  if (
    ticket.booking_status === "cancelled" ||
    ticket.ticket_status === "cancelled"
  ) {
    return {
      label: "Cancelled",
      icon: XCircle,
      style: "bg-red-100 text-red-700 dark:bg-red-950 dark:text-red-300",
    };
  }

  if (
    ticket.booking_status === "expired" ||
    ticket.ticket_status === "expired" ||
    new Date(ticket.ends_at).getTime() < Date.now()
  ) {
    return {
      label: "Expired",
      icon: Clock,
      style: "bg-gray-100 text-gray-600 dark:bg-gray-800 dark:text-gray-300",
    };
  }

  if (ticket.ticket_status === "checked_in") {
    return {
      label: "Checked in",
      icon: CheckCircle2,
      style: "bg-green-100 text-green-700 dark:bg-green-950 dark:text-green-300",
    };
  }

  return {
    label: "Upcoming",
    icon: AlertCircle,
    style: "bg-orange-100 text-orange-700 dark:bg-orange-950 dark:text-orange-300",
  };
}

function formatDate(value: string) {
  return new Date(value).toLocaleDateString("en-IN", {
    weekday: "short",
    day: "numeric",
    month: "long",
    year: "numeric",
  });
}

function formatTime(value: string) {
  return new Date(value).toLocaleTimeString("en-IN", {
    hour: "2-digit",
    minute: "2-digit",
  });
}

export default function DashboardPage() {
  const { user, profile, loading: authLoading } = useAuth();
  const { isDarkMode, setIsDarkMode } = useTheme();

  const [tickets, setTickets] = useState<MyTicket[]>([]);
  const [loading, setLoading] = useState(true);
  const [error, setError] = useState("");

  const fetchTickets = useCallback(async () => {
    setLoading(true);
    setError("");

    try {
      const data = await getMyTickets();
      setTickets(data);
    } catch (err) {
      setError(
        err instanceof Error
          ? err.message
          : "Unable to load your tickets."
      );
    } finally {
      setLoading(false);
    }
  }, []);

 useEffect(() => {
  if (authLoading || !user) return;

  let cancelled = false;

  getMyTickets()
    .then((data) => {
      if (!cancelled) {
        setTickets(data);
        setError("");
      }
    })
    .catch((err) => {
      if (!cancelled) {
        setError(
          err instanceof Error
            ? err.message
            : "Unable to load your tickets."
        );
      }
    })
    .finally(() => {
      if (!cancelled) setLoading(false);
    });

  return () => {
    cancelled = true;
  };
}, [authLoading, user]);

  const background = isDarkMode
    ? "bg-[#171A19] text-[#FFF8EB]"
    : "bg-[#FFF8EB] text-[#38231C]";

  const cardStyle = isDarkMode
    ? "border-[#414943] bg-[#222725]"
    : "border-[#EADCC9] bg-white";

  const mutedText = isDarkMode
    ? "text-[#AFA99C]"
    : "text-[#806B5D]";

  if (authLoading) {
    return (
      <main className={`min-h-screen ${background}`}>
        <Navbar
          isDarkMode={isDarkMode}
          setIsDarkMode={setIsDarkMode}
        />
        <div className="flex min-h-[60vh] items-center justify-center">
          Loading your account...
        </div>
      </main>
    );
  }

  if (!user) {
    return (
      <main className={`min-h-screen ${background}`}>
        <Navbar
          isDarkMode={isDarkMode}
          setIsDarkMode={setIsDarkMode}
        />
        <div className="mx-auto max-w-xl px-6 py-24 text-center">
          <Ticket size={42} className="mx-auto text-[#F0440A]" />
          <h1 className="mt-5 text-2xl font-bold">
            Sign in to view your tickets
          </h1>
          <p className={`mt-2 ${mutedText}`}>
            Your event bookings and QR tickets will appear here.
          </p>
          <Link
            href="/login"
            className="mt-6 inline-flex rounded-xl bg-[#F0440A] px-6 py-3 font-semibold text-white"
          >
            Login
          </Link>
        </div>
      </main>
    );
  }

  return (
    <main className={`min-h-screen transition-colors ${background}`}>
      <Navbar
        isDarkMode={isDarkMode}
        setIsDarkMode={setIsDarkMode}
      />

      <div className="mx-auto max-w-6xl px-4 py-10 sm:px-6 lg:px-8">
        {/* Header */}
        <div className="flex flex-col justify-between gap-4 sm:flex-row sm:items-end">
          <div>
            <p className="text-xs font-bold uppercase tracking-[0.2em] text-[#F0440A]">
              Your UtsavZero account
            </p>

            <h1 className="mt-2 font-[var(--font-lora)] text-3xl font-bold sm:text-4xl">
              My Tickets
            </h1>

            <p className={`mt-2 ${mutedText}`}>
              Welcome, {profile?.full_name || user.email}.
              {" "}Your celebrations, all in one place.
            </p>
          </div>

          <button
            type="button"
            onClick={fetchTickets}
            disabled={loading}
            className={`inline-flex items-center justify-center gap-2 rounded-xl border px-4 py-2.5 text-sm font-semibold disabled:opacity-50 ${
              isDarkMode
                ? "border-[#414943] hover:bg-[#292E2B]"
                : "border-[#EADCC9] hover:bg-[#FFF0D8]"
            }`}
          >
            <RefreshCw
              size={16}
              className={loading ? "animate-spin" : ""}
            />
            Refresh tickets
          </button>
        </div>

        {/* Ticket count */}
        <div className={`mt-8 flex items-center gap-4 rounded-2xl border p-5 ${cardStyle}`}>
          <div className="flex h-12 w-12 items-center justify-center rounded-xl bg-orange-100 text-[#F0440A] dark:bg-orange-950">
            <Ticket size={24} />
          </div>

          <div>
            <p className="text-2xl font-bold tabular-nums">
              {tickets.length}
            </p>
            <p className={`text-sm ${mutedText}`}>
              Group booking{tickets.length === 1 ? "" : "s"} found
            </p>
          </div>
        </div>

        {/* Loading */}
        {loading && (
          <div className="py-20 text-center">
            <RefreshCw
              size={28}
              className="mx-auto animate-spin text-[#F0440A]"
            />
            <p className={`mt-4 text-sm ${mutedText}`}>
              Loading your tickets...
            </p>
          </div>
        )}

        {/* Error */}
        {!loading && error && (
          <div className="mt-8 rounded-2xl border border-red-300 bg-red-50 p-6 text-red-700 dark:border-red-900 dark:bg-red-950/30 dark:text-red-300">
            <p className="font-semibold">Unable to load tickets</p>
            <p className="mt-2 text-sm">{error}</p>
            <button
              onClick={fetchTickets}
              className="mt-4 rounded-lg bg-[#F0440A] px-4 py-2 text-sm font-semibold text-white"
            >
              Try again
            </button>
          </div>
        )}

        {/* Empty state */}
        {!loading && !error && tickets.length === 0 && (
          <div className={`mt-8 rounded-2xl border px-6 py-16 text-center ${cardStyle}`}>
            <Ticket
              size={46}
              className="mx-auto text-[#F0440A]"
            />
            <h2 className="mt-5 text-xl font-bold">
              No tickets yet
            </h2>
            <p className={`mx-auto mt-2 max-w-md text-sm ${mutedText}`}>
              You haven&apos;t booked any celebrations yet.
              Explore community events and find your next celebration.
            </p>
            <Link
              href="/events"
              className="mt-6 inline-flex rounded-xl bg-gradient-to-r from-[#FFBE45] to-[#F0440A] px-6 py-3 text-sm font-bold text-white"
            >
              Explore events
            </Link>
          </div>
        )}

        {/* Tickets */}
        {!loading && !error && tickets.length > 0 && (
          <div className="mt-8 space-y-6">
            {tickets.map((ticket) => {
              const status = getTicketStatus(ticket);
              const StatusIcon = status.icon;

              return (
                <article
                  key={ticket.ticket_id}
                  className={`overflow-hidden rounded-2xl border shadow-sm ${cardStyle}`}
                >
                  <div className="grid md:grid-cols-[1fr_280px]">
                    {/* Ticket information */}
                    <div className="p-5 sm:p-7">
                      <div className="flex flex-wrap items-center justify-between gap-3">
                        <span className="rounded-full bg-orange-100 px-3 py-1 text-xs font-bold text-orange-700 dark:bg-orange-950 dark:text-orange-300">
                          UTSAVZERO GROUP TICKET
                        </span>

                        <span className={`inline-flex items-center gap-1.5 rounded-full px-3 py-1 text-xs font-semibold ${status.style}`}>
                          <StatusIcon size={14} />
                          {status.label}
                        </span>
                      </div>

                      <h2 className="mt-5 text-2xl font-bold">
                        {ticket.event_title}
                      </h2>

                      <div className={`mt-5 space-y-3 text-sm ${mutedText}`}>
                        <p className="flex items-center gap-3">
                          <CalendarDays size={17} className="shrink-0 text-[#F0440A]" />
                          {formatDate(ticket.starts_at)}
                        </p>

                        <p className="flex items-center gap-3">
                          <Clock size={17} className="shrink-0 text-[#F0440A]" />
                          {formatTime(ticket.starts_at)}
                          {" – "}
                          {formatTime(ticket.ends_at)}
                        </p>

                        <p className="flex items-center gap-3">
                          <MapPin size={17} className="shrink-0 text-[#F0440A]" />
                          {ticket.venue_name || ticket.address || "Venue details unavailable"}
                        </p>

                        <p className="flex items-center gap-3">
                          <Users size={17} className="shrink-0 text-[#F0440A]" />
                          {ticket.quantity} {ticket.quantity === 1 ? "person" : "people"} included
                        </p>
                      </div>

                      <div className={`mt-6 grid gap-4 border-t pt-5 sm:grid-cols-2 ${
                        isDarkMode ? "border-[#414943]" : "border-[#EADCC9]"
                      }`}>
                        <div>
                          <p className={`text-xs ${mutedText}`}>
                            Booking reference
                          </p>
                          <p className="mt-1 font-mono text-sm font-bold">
                            {ticket.booking_reference}
                          </p>
                        </div>

                        <div>
                          <p className={`text-xs ${mutedText}`}>
                            Ticket number
                          </p>
                          <p className="mt-1 font-mono text-sm font-bold">
                            {ticket.ticket_number}
                          </p>
                        </div>

                        <div>
                          <p className={`text-xs ${mutedText}`}>
                            Booked by
                          </p>
                          <p className="mt-1 text-sm font-semibold">
                            {ticket.attendee_name}
                          </p>
                        </div>

                        <div>
                          <p className={`text-xs ${mutedText}`}>
                            Booking amount
                          </p>
                          <p className="mt-1 text-sm font-semibold">
                            {new Intl.NumberFormat("en-IN", {
                              style: "currency",
                              currency: ticket.currency || "INR",
                              maximumFractionDigits: 2,
                            }).format(Number(ticket.total_amount) || 0)}
                          </p>
                        </div>
                      </div>

                      {ticket.ticket_status === "checked_in" && (
                        <p className="mt-5 rounded-xl bg-green-100 p-3 text-sm text-green-800 dark:bg-green-950 dark:text-green-300">
                          Checked in
                          {ticket.checked_in_at
                            ? ` on ${new Date(ticket.checked_in_at).toLocaleString("en-IN")}`
                            : "."}
                        </p>
                      )}

                      {ticket.booking_status === "confirmed" &&
                        Number(ticket.total_amount) > 0 && (
                          <p className="mt-4 text-xs text-amber-600 dark:text-amber-400">
                            Demo booking: payment is not processed through a live payment gateway.
                          </p>
                        )}
                    </div>

                    {/* QR code */}
                    <div className={`flex flex-col items-center justify-center border-t p-6 md:border-l md:border-t-0 ${
                      isDarkMode
                        ? "border-[#414943] bg-[#1D2220]"
                        : "border-[#EADCC9] bg-[#FFF9F0]"
                    }`}>
                      <p className="mb-4 text-sm font-bold">
                        Your entry QR
                      </p>

                      {ticket.qr_token ? (
                        <BookingQRCode
                          value={ticket.qr_token}
                          size={190}
                        />
                      ) : (
                        <p className="text-sm text-red-500">
                          QR code unavailable
                        </p>
                      )}

                      <p className={`mt-4 max-w-[220px] text-center text-xs ${mutedText}`}>
                        Present this QR code at the event entrance.
                        One scan verifies the entire group booking.
                      </p>
                    </div>
                  </div>
                </article>
              );
            })}
          </div>
        )}

        <div className="mt-10 text-center">
          <Link
            href="/events"
            className="text-sm font-semibold text-[#F0440A] hover:underline"
          >
            Discover more celebrations →
          </Link>
        </div>
      </div>
    </main>
  );
}
</file>

<file path="src/components/civic/layout/CivicLayout.tsx">
"use client";

import type { ReactNode } from "react";
import Link from "next/link";
import { usePathname } from "next/navigation";

import {
  LayoutDashboard,
  Map,
  MapPinned,
  ClipboardCheck,
  ChartNoAxesCombined,
  History,
  ShieldCheck,
} from "lucide-react";

import Navbar from "@/components/layout/Navbar";
import { useTheme } from "@/context/ThemeContext";

interface CivicLayoutProps {
  children: ReactNode;
  title: string;
  description?: string;
}

const navigation = [
  {
    label: "Overview",
    href: "/civic",
    icon: LayoutDashboard,
  },
  {
    label: "Locality Explorer",
    href: "/civic/localities",
    icon: Map,
  },
  {
    label: "Zone Planning",
    href: "/civic/zones",
    icon: MapPinned,
  },
  {
    label: "Applications & Authorizations",
    href: "/civic/authorizations",
    icon: ClipboardCheck,
  },
  {
    label: "Planning Intelligence",
    href: "/civic/intelligence",
    icon: ChartNoAxesCombined,
  },
  {
    label: "Audit History",
    href: "/civic/audit",
    icon: History,
  },
];

export default function CivicLayout({
  children,
  title,
  description,
}: CivicLayoutProps) {
  const pathname = usePathname();
  const { isDarkMode, setIsDarkMode } = useTheme();

  // Original UtsavZero theme
  const colors = {
    page: isDarkMode
      ? "bg-[#171A19] text-[#F5EBDD]"
      : "bg-[#FFF8EB] text-[#38231C]",

    heading: isDarkMode
      ? "text-[#F5EBDD]"
      : "text-[#38231C]",

    muted: isDarkMode
      ? "text-[#B8B0A4]"
      : "text-[#806B5D]",

    border: isDarkMode
      ? "border-[#343B36]"
      : "border-[#EADCC9]",

    card: isDarkMode
      ? "border-[#343B36] bg-[#202522]"
      : "border-[#EADCC9] bg-white",

    inactiveNav: isDarkMode
      ? "text-[#B8B0A4] hover:bg-[#292E2B] hover:text-[#F5EBDD]"
      : "text-[#806B5D] hover:bg-[#F5EBDD] hover:text-[#38231C]",

    mobileNav: isDarkMode
      ? "bg-[#292E2B] text-[#B8B0A4]"
      : "bg-[#F5EBDD] text-[#806B5D]",

    demoBadge: isDarkMode
      ? "bg-[#39271D] text-[#FF9A57]"
      : "bg-[#FFF0D8] text-[#E65B16]",

    footerText: isDarkMode
      ? "text-[#99958B]"
      : "text-[#A08C7D]",
  };

  const isActiveRoute = (href: string) => {
    return href === "/civic"
      ? pathname === "/civic"
      : pathname === href || pathname.startsWith(`${href}/`);
  };

  return (
    <div
      className={`min-h-screen transition-colors duration-300 ${colors.page}`}
    >
      {/* Existing UtsavZero Navbar */}
      <Navbar
        isDarkMode={isDarkMode}
        setIsDarkMode={setIsDarkMode}
      />

      <div className="mx-auto flex max-w-[1700px] gap-6 px-4 pb-10 sm:px-6 lg:px-8">

        {/* Civic Sidebar */}
        <aside
          className={`hidden w-[245px] shrink-0 border-r py-8 pr-5 lg:flex lg:flex-col ${colors.border}`}
        >
          <div className="mb-7 px-3">
            <div className="flex items-center gap-2">
              <ShieldCheck
                size={20}
                className="text-[#F0440A]"
              />

              <span className="text-sm font-bold">
                Civic Workspace
              </span>
            </div>

            <p className={`mt-2 text-xs ${colors.muted}`}>
              Geospatial planning and intelligence
            </p>
          </div>

          <p
            className={`mb-3 px-3 text-[10px] font-bold uppercase tracking-[0.18em] ${colors.muted}`}
          >
            Planning Modules
          </p>

          <nav className="flex flex-col gap-1.5">
            {navigation.map((item) => {
              const Icon = item.icon;
              const isActive = isActiveRoute(item.href);

              return (
                <Link
                  key={item.href}
                  href={item.href}
                  className={`flex items-center gap-3 rounded-xl px-3 py-3 text-sm font-medium transition-colors ${
                    isActive
                      ? "bg-gradient-to-r from-[#FF6A16] to-[#F0440A] text-white shadow-sm"
                      : colors.inactiveNav
                  }`}
                >
                  <Icon size={18} />
                  {item.label}
                </Link>
              );
            })}
          </nav>

          {/* Access Information */}
          <div className="mt-auto px-2 pt-8">
            <div className={`rounded-xl border p-3 ${colors.card}`}>
              <div className="flex items-center gap-2">
                <ShieldCheck
                  size={16}
                  className="text-[#F0440A]"
                />

                <span className="text-xs font-bold">
                  Restricted Access
                </span>
              </div>

              <p className={`mt-2 text-[11px] leading-5 ${colors.muted}`}>
                Civic workspace access is limited to authorised
                demonstration accounts.
              </p>
            </div>
          </div>
        </aside>

        {/* Main Content */}
        <main className="min-w-0 flex-1 py-6 sm:py-8">

          {/* Page Heading */}
          <div className="mb-6">
            <div className="mb-2 flex flex-wrap items-center gap-2">
              <span className="text-[10px] font-bold uppercase tracking-[0.18em] text-[#F0440A]">
                UtsavZero · Civic Intelligence
              </span>

              <span
                className={`rounded-full px-2 py-1 text-[9px] font-bold uppercase tracking-wider ${colors.demoBadge}`}
              >
                Demo Environment
              </span>
            </div>

            <h1
              className={`font-[var(--font-lora)] text-2xl font-bold sm:text-3xl ${colors.heading}`}
            >
              {title}
            </h1>

            {description && (
              <p className={`mt-2 max-w-3xl text-sm sm:text-base ${colors.muted}`}>
                {description}
              </p>
            )}
          </div>

          {/* Mobile Navigation */}
          <div className="mb-6 flex gap-2 overflow-x-auto pb-2 lg:hidden">
            {navigation.map((item) => {
              const Icon = item.icon;
              const isActive = isActiveRoute(item.href);

              return (
                <Link
                  key={item.href}
                  href={item.href}
