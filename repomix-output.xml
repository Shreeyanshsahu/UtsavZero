<file path="scripts/convert-osm-ward.mjs">
import fs from "node:fs/promises";
import path from "node:path";
import osmtogeojson from "osmtogeojson";

const ROOT = process.cwd();

const OSM_DIR = path.join(ROOT, "data/geodata/osm");
const BULK_DIR = path.join(OSM_DIR, "bulk");

const wardId = process.argv[2];

if (!wardId || !/^[A-Za-z0-9_-]+$/.test(wardId)) {
  console.error(
    "Usage: node scripts/convert-osm-ward.mjs <ward-id>"
  );
  process.exit(1);
}

const BULK_INPUT = path.join(
  BULK_DIR,
  "raw",
  `ward-${wardId}-osm-raw.json`
);

const LEGACY_INPUT = path.join(
  OSM_DIR,
  `ward-${wardId}-osm-raw.json`
);

const BULK_OUTPUT = path.join(
  BULK_DIR,
  "converted",
  `ward-${wardId}-osm.geojson`
);

const LEGACY_OUTPUT = path.join(
  OSM_DIR,
  `ward-${wardId}-osm.geojson`
);

async function fileExists(file) {
  try {
    await fs.access(file);
    return true;
  } catch {
    return false;
  }
}

async function main() {
  console.log(`Converting OSM data for ward ${wardId}...`);

  // Prefer bulk data; fall back to the legacy Ward 111 directory.
  const useBulk = await fileExists(BULK_INPUT);

  const INPUT = useBulk ? BULK_INPUT : LEGACY_INPUT;
  const OUTPUT = useBulk ? BULK_OUTPUT : LEGACY_OUTPUT;

  if (!(await fileExists(INPUT))) {
    throw new Error(`Raw OSM input file not found: ${INPUT}`);
  }

  console.log("Input:", INPUT);

  const raw = JSON.parse(await fs.readFile(INPUT, "utf8"));

  if (!Array.isArray(raw.elements)) {
    throw new Error("Invalid OSM response: elements array missing.");
  }

  console.log("Raw OSM elements:", raw.elements.length);

  const geojson = osmtogeojson(raw);

  const tagCounts = {};

  for (const feature of geojson.features) {
    const tags = feature.properties ?? {};

    for (const key of [
      "amenity",
      "healthcare",
      "landuse",
      "highway",
      "building",
      "name",
      "leisure",
    ]) {
      const value = tags[key];

      if (value) {
        const label = `${key}=${value}`;
        tagCounts[label] = (tagCounts[label] || 0) + 1;
      }
    }
  }

  console.log("\nOSM tag distribution:");

  for (const [tag, count] of Object.entries(tagCounts).sort(
    (a, b) => b[1] - a[1]
  )) {
    console.log(`${tag}: ${count}`);
  }

  const geometryCounts = {};

  for (const feature of geojson.features) {
    const type = feature.geometry?.type ?? "Unknown";
    geometryCounts[type] = (geometryCounts[type] || 0) + 1;
  }

  await fs.mkdir(path.dirname(OUTPUT), { recursive: true });

  await fs.writeFile(
    OUTPUT,
    JSON.stringify(geojson, null, 2),
    "utf8"
  );

  console.log("\nConversion successful!");
  console.log("Ward:", wardId);
  console.log("Total features:", geojson.features.length);
  console.log("Geometry counts:", geometryCounts);
  console.log("Output:", OUTPUT);
}

main().catch((error) => {
  console.error("Conversion failed:", error.message);
  process.exitCode = 1;
});
</file>

<file path="scripts/import-all-wards.mjs">
import { spawn } from "node:child_process";
import fs from "node:fs";
import path from "node:path";

const ROOT = process.cwd();

const WARDS_FILE = path.join(
    ROOT,
    "data/geodata/delhi_wards.geojson"
);

const BULK_DIR = path.join(
    ROOT,
    "data/geodata/osm/bulk"
);

const REPORT_DIR = path.join(BULK_DIR, "reports");

const APPLY = process.argv.includes("--apply");
const REFRESH = process.argv.includes("--refresh");
const RETRY_FAILED = process.argv.includes("--retry-failed");

const BATCH_SIZE = 100;

const batchIndex = process.argv.indexOf("--batch");
const batchNumber =
    batchIndex !== -1
        ? Number(process.argv[batchIndex + 1])
        : null;

const SCRIPTS = [
    "scripts/import-osm-ward.mjs",
    "scripts/convert-osm-ward.mjs",
    "scripts/preview-osm-classification.mjs",
    "scripts/import-osm-features-bulk.mjs",
];

const MODE = APPLY ? "apply" : "dry-run";

const PROGRESS_FILE = path.join(
    REPORT_DIR,
    `bulk-progress-${MODE}.json`
);

function sleep(ms) {
    return new Promise((resolve) => setTimeout(resolve, ms));
}

function loadProgress() {
    if (!fs.existsSync(PROGRESS_FILE)) {
        return {
            mode: MODE,
            wards: {},
        };
    }

    const progress = JSON.parse(
        fs.readFileSync(PROGRESS_FILE, "utf8")
    );

    if (progress.mode !== MODE) {
        throw new Error("Progress file mode mismatch.");
    }

    return progress;
}

function saveProgress(progress) {
    const temporaryFile = `${PROGRESS_FILE}.tmp`;

    fs.writeFileSync(
        temporaryFile,
        JSON.stringify(progress, null, 2)
    );

    fs.renameSync(temporaryFile, PROGRESS_FILE);
}

function loadWardIds() {
    const geojson = JSON.parse(
        fs.readFileSync(WARDS_FILE, "utf8")
    );

    if (!Array.isArray(geojson.features)) {
        throw new Error("Invalid Delhi wards GeoJSON.");
    }

    return geojson.features.map((feature, index) => {
        const rawId = feature.properties?.Ward_No;

        const wardId =
            rawId === null ||
            rawId === undefined ||
            String(rawId).trim() === ""
                ? `unidentified-${index + 1}`
                : String(rawId).trim();

        if (!/^[A-Za-z0-9_-]+$/.test(wardId)) {
            throw new Error(
                `Unsupported ward identifier at feature ${index + 1}: ${wardId}`
            );
        }

        return wardId;
    });
}

function runScript(script, args) {
    return new Promise((resolve) => {
        console.log(
            `\n▶ Running: node ${script} ${args.join(" ")}`
        );

        const child = spawn(
            process.execPath,
            [script, ...args],
            {
                cwd: ROOT,
                stdio: "inherit",
            }
        );

        child.on("error", (error) => {
            resolve({
                success: false,
                error: error.message,
            });
        });

        child.on("close", (code, signal) => {
            resolve({
                success: code === 0,
                exitCode: code,
                signal: signal ?? null,
            });
        });
    });
}

async function processWard(wardId) {
    const stages = [];

    for (let i = 0; i < SCRIPTS.length; i++) {
        const script = SCRIPTS[i];

        let args;

        // Fetcher and importer use --ward.
        // Converter and classifier use positional IDs.
        if (i === 0 || i === 3) {
            args = ["--ward", wardId];
        } else {
            args = [wardId];
        }

        if (i === 0 && REFRESH) {
            args.push("--refresh");
        }

        // Never enable database writes accidentally.
        if (i === 3 && APPLY) {
            args.push("--apply");
        }

        const result = await runScript(script, args);

        stages.push({
            script,
            ...result,
        });

        if (!result.success) {
            return {
                success: false,
                failedAt: script,
                stages,
            };
        }
    }

    return {
        success: true,
        stages,
    };
}

async function main() {
    if (!fs.existsSync(WARDS_FILE)) {
        throw new Error(`Ward file not found: ${WARDS_FILE}`);
    }

    if (batchIndex !== -1) {
        if (
            !Number.isInteger(batchNumber) ||
            batchNumber < 1
        ) {
            throw new Error(
                "Usage: --batch <positive batch number>"
            );
        }
    }

    if (RETRY_FAILED && batchNumber !== null) {
        throw new Error(
            "Use either --retry-failed or --batch, not both."
        );
    }

    if (REFRESH && !APPLY) {
        console.log(
            "NOTE: OSM cache refresh is enabled for this dry run."
        );
    }

    fs.mkdirSync(REPORT_DIR, { recursive: true });

    const wardIds = loadWardIds();
    const progress = loadProgress();

    let selectedWards;

    if (RETRY_FAILED) {
        selectedWards = wardIds.filter((id) => {
            const entry = progress.wards[id];

            return entry && entry.success === false;
        });
    } else if (batchNumber !== null) {
        const start = (batchNumber - 1) * BATCH_SIZE;

        selectedWards = wardIds.slice(
            start,
            start + BATCH_SIZE
        );

        if (selectedWards.length === 0) {
            throw new Error(
                `Batch ${batchNumber} does not exist.`
            );
        }
    } else {
        throw new Error(
            "Specify --batch <number> or --retry-failed."
        );
    }

    console.log("\n====================================");
    console.log("UTSAVZERO — RESUMABLE OSM IMPORT");
    console.log("====================================");
    console.log(`Total source wards: ${wardIds.length}`);
    console.log(`Selected wards: ${selectedWards.length}`);
    console.log(`Batch size: ${BATCH_SIZE}`);
    console.log(`Mode: ${APPLY ? "APPLY" : "DRY RUN"}`);
    console.log(`Refresh cache: ${REFRESH}`);
    console.log(`Progress file: ${PROGRESS_FILE}`);
    console.log("====================================");

    const batchResults = [];

    for (let i = 0; i < selectedWards.length; i++) {
        const wardId = selectedWards[i];

        const previous = progress.wards[wardId];

        if (previous?.success === true) {
            console.log(
                `\n⏭ Skipping ${wardId}: already completed in ${MODE} mode.`
            );

            continue;
        }

        console.log(
            `\n\n========== WARD ${wardId} (${i + 1}/${selectedWards.length}) ==========`
        );

        const startedAt = new Date().toISOString();

        const result = await processWard(wardId);

        const wardResult = {
            wardId,
            success: result.success,
            failedAt: result.failedAt ?? null,
            startedAt,
            completedAt: new Date().toISOString(),
            stages: result.stages,
        };

        progress.wards[wardId] = wardResult;

        // Save immediately after every ward.
        saveProgress(progress);

        batchResults.push(wardResult);

        console.log(
            result.success
                ? `✅ ${wardId} completed`
                : `❌ ${wardId} failed at ${result.failedAt}`
        );

        if (i < selectedWards.length - 1) {
            await sleep(3000);
        }
    }

    const allSuccessful = Object.values(progress.wards)
        .filter((entry) => entry.success).length;

    const allFailed = Object.values(progress.wards)
        .filter((entry) => entry.success === false).length;

    const report = {
        generatedAt: new Date().toISOString(),
        mode: MODE,
        batch: RETRY_FAILED ? "retry-failed" : batchNumber,
        batchSize: BATCH_SIZE,
        selected: selectedWards.length,
        successfulThisRun: batchResults.filter(
            (entry) => entry.success
        ).length,
        failedThisRun: batchResults.filter(
            (entry) => !entry.success
        ).length,
        totalSuccessfulInProgress: allSuccessful,
        totalFailedInProgress: allFailed,
        results: batchResults,
    };

    const reportPath = path.join(
        REPORT_DIR,
        `batch-${RETRY_FAILED ? "retry" : batchNumber}-${MODE}-${Date.now()}.json`
    );

    fs.writeFileSync(
        reportPath,
        JSON.stringify(report, null, 2)
    );

    console.log("\n====================================");
    console.log("BATCH SUMMARY");
    console.log("====================================");
    console.log(`Successful this run: ${report.successfulThisRun}`);
    console.log(`Failed this run: ${report.failedThisRun}`);
    console.log(`Total successful: ${allSuccessful}`);
    console.log(`Total failed: ${allFailed}`);
    console.log(`Report: ${reportPath}`);
    console.log(`Progress: ${PROGRESS_FILE}`);
}

main().catch((error) => {
    console.error("\nBULK IMPORT STOPPED:", error);
    process.exitCode = 1;
});
</file>

<file path="scripts/import-delhi-geodata.mjs">
import fs from "node:fs";
import path from "node:path";
import crypto from "node:crypto";
import { createClient } from "@supabase/supabase-js";

const ROOT = process.cwd();
const DATA_DIR = path.join(ROOT, "data/geodata");

const BOUNDARY_FILE = path.join(DATA_DIR, "delhi_boundary.geojson");
const WARDS_FILE = path.join(DATA_DIR, "delhi_wards.geojson");

const SOURCE_NAME = "India Geodata - Delhi Municipal Boundaries";

const SOURCE_URLS = {
  boundary:
    "https://raw.githubusercontent.com/yashveeeeeeer/india-geodata/main/data/urban/municipal-boundaries/delhi/Delhi_Boundary.geojson",

  wards:
    "https://raw.githubusercontent.com/yashveeeeeeer/india-geodata/main/data/urban/municipal-boundaries/delhi/Delhi_Wards.geojson",
};

// Stable UUID v5 generation.
const NAMESPACE = Buffer.from(
    "6ba7b8109dad11d180b400c04fd430c8",
    "hex"
);

function stableUUID(value) {
    const hash = crypto
        .createHash("sha1")
        .update(Buffer.concat([NAMESPACE, Buffer.from(value)]))
        .digest();

    hash[6] = (hash[6] & 0x0f) | 0x50;
    hash[8] = (hash[8] & 0x3f) | 0x80;

    const hex = hash.subarray(0, 16).toString("hex");

    return [
        hex.slice(0, 8),
        hex.slice(8, 12),
        hex.slice(12, 16),
        hex.slice(16, 20),
        hex.slice(20),
    ].join("-");
}

function readGeoJSON(filePath) {
    if (!fs.existsSync(filePath)) {
        throw new Error(`File not found: ${filePath}`);
    }

    return JSON.parse(fs.readFileSync(filePath, "utf8"));
}

function validateFeatureCollection(data, label) {
    if (data.type !== "FeatureCollection") {
        throw new Error(`${label} is not a FeatureCollection.`);
    }

    if (!Array.isArray(data.features)) {
        throw new Error(`${label} has no features array.`);
    }

    for (const [index, feature] of data.features.entries()) {
        if (feature.type !== "Feature") {
            throw new Error(`${label}: feature ${index} is invalid.`);
        }

        if (
            !feature.geometry ||
            !["Polygon", "MultiPolygon"].includes(feature.geometry.type)
        ) {
            throw new Error(
                `${label}: feature ${index} has an unsupported geometry.`
            );
        }

        if (!Array.isArray(feature.geometry.coordinates)) {
            throw new Error(
                `${label}: feature ${index} has invalid coordinates.`
            );
        }
    }

    return data.features;
}

function buildRecords() {
    const boundaryData = readGeoJSON(BOUNDARY_FILE);
    const wardsData = readGeoJSON(WARDS_FILE);

    const boundaryFeatures = validateFeatureCollection(
        boundaryData,
        "Delhi boundary"
    );

    const wardFeatures = validateFeatureCollection(
        wardsData,
        "Delhi wards"
    );

    if (boundaryFeatures.length !== 1) {
        throw new Error(
            `Expected 1 Delhi boundary, found ${boundaryFeatures.length}.`
        );
    }

    if (wardFeatures.length !== 290) {
        throw new Error(
            `Expected 290 ward features, found ${wardFeatures.length}.`
        );
    }

    const boundary = boundaryFeatures[0];

    const records = [
        {
            id: stableUUID("utsavzero:locality:delhi-boundary"),
            name: "Delhi",
            city: "Delhi",
            state: "Delhi",
            boundary_geojson: boundary,
            data_source: `${SOURCE_NAME} | ${SOURCE_URLS.boundary}`,
            source_date: null,
            source_feature_id: "delhi-boundary",
            locality_type: "city",
        },
    ];

    const seenWardNumbers = new Set();

    wardFeatures.forEach((feature, index) => {
        const properties = feature.properties ?? {};

        const wardNumber = properties.Ward_No;
        const wardName = properties.Ward_Name;

        const hasWardNumber =
            wardNumber !== null &&
            wardNumber !== undefined &&
            String(wardNumber).trim() !== "";

        const sourceFeatureId = hasWardNumber
            ? `ward-${String(wardNumber).trim()}`
            : `unidentified-${index + 1}`;

        if (hasWardNumber) {
            if (seenWardNumbers.has(String(wardNumber))) {
                throw new Error(`Duplicate ward number: ${wardNumber}`);
            }

            seenWardNumbers.add(String(wardNumber));
        }

        const name =
            hasWardNumber && wardName
                ? `Ward ${wardNumber} - ${wardName}`
                : `Unidentified ward (source feature ${index + 1})`;

        records.push({
            id: stableUUID(`utsavzero:locality:${sourceFeatureId}`),
            name,
            city: "Delhi",
            state: "Delhi",
            boundary_geojson: feature,
            data_source: `${SOURCE_NAME} | ${SOURCE_URLS.wards}`,
            source_date: null,
            source_feature_id: sourceFeatureId,
            locality_type: "ward",
        });
    });

    return {
        records,
        unidentifiedCount: wardFeatures.filter((feature) => {
            const props = feature.properties ?? {};

            return (
                props.Ward_No == null ||
                String(props.Ward_No).trim() === ""
            );
        }).length,
    };
}

async function main() {
    const { records, unidentifiedCount } = buildRecords();

    console.log("\n========== UTSAVZERO GEO DATA ==========");
    console.log("Delhi boundary records:", 1);
    console.log("Ward records:", records.length - 1);
    console.log("Total locality records:", records.length);
    console.log("Unidentified ward features:", unidentifiedCount);

    console.log("\nSample records:");

    for (const record of [
        records[0],
        records[1],
        records[records.length - 1],
    ]) {
        console.log({
            id: record.id,
            name: record.name,
            locality_type: record.locality_type,
            source_feature_id: record.source_feature_id,
            geometry_type: record.boundary_geojson.geometry.type,
        });
    }

    if (!process.argv.includes("--apply")) {
        console.log("\nDRY RUN COMPLETE.");
        console.log("No database records were inserted or updated.");
        console.log("Use --apply only after reviewing this output.");
        return;
    }

    const supabaseUrl = process.env.NEXT_PUBLIC_SUPABASE_URL;
    const secretKey = process.env.SUPABASE_SECRET_KEY;

    if (!supabaseUrl || !secretKey) {
        throw new Error(
            "Missing NEXT_PUBLIC_SUPABASE_URL or SUPABASE_SECRET_KEY."
        );
    }

    const supabase = createClient(supabaseUrl, secretKey, {
        auth: {
            autoRefreshToken: false,
            persistSession: false,
        },
    });

    // Refuse to import if the target table is not empty.
    // This avoids silently mixing this dataset with unrelated records.
    // Allow safe retries, but refuse to overwrite unrelated localities.
    const expectedIds = new Set(records.map((record) => record.id));

    const { data: existingRows, error: existingError } = await supabase
        .from("localities")
        .select("id");

    if (existingError) {
        throw new Error(
            `Unable to inspect existing localities: ${existingError.message}`
        );
    }

    const unrelatedRecords = (existingRows ?? []).filter(
        (row) => !expectedIds.has(row.id)
    );

    if (unrelatedRecords.length > 0) {
        throw new Error(
            `Import stopped: found ${unrelatedRecords.length} unrelated locality records.`
        );
    }

    const BATCH_SIZE = 50;

    for (let i = 0; i < records.length; i += BATCH_SIZE) {
        const batch = records.slice(i, i + BATCH_SIZE);

        const { error } = await supabase
            .from("localities")
            .upsert(batch, { onConflict: "id" });

        if (error) {
            throw new Error(
                `Import failed at batch ${Math.floor(i / BATCH_SIZE) + 1}: ${error.message}`
            );
        }

        console.log(
            `Inserted ${Math.min(i + BATCH_SIZE, records.length)} / ${records.length}`
        );
    }

    const { count: finalCount, error: verifyError } = await supabase
        .from("localities")
        .select("id", { count: "exact", head: true });

    if (verifyError) {
        throw new Error(`Verification failed: ${verifyError.message}`);
    }

    console.log("\nIMPORT COMPLETE");
    console.log("Verified locality records:", finalCount);
}

main().catch((error) => {
    console.error("\nIMPORT ERROR:", error.message);
    process.exitCode = 1;
});
